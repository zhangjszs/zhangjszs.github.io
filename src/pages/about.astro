---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { iconPaths } from '../components/IconPaths';
import RadarChart from '../components/RadarChart.astro';

// ============================================================
// 静态个人信息（站名、身份、时间线"现在"段、联系方式）
// 改这里就行；下面的"技能/标签/时间线"是项目数据自动聚合的
// ============================================================

/** 身份标签 */
const ROLE = '自动驾驶工程学生 / 湖北汽车工业学院 FSAC 车队';

/** 个人简介段落（出现在 About 背景区，可写多段） */
const ABOUT_PARAGRAPHS: string[] = [
	'我是 Kerwin Zhang，湖北汽车工业学院的本科生，目前在 FSAC 车队做自动驾驶相关工作，方向覆盖感知、定位、规划与控制全流程。',
	'研究兴趣集中在 LiDAR 地面分割与锥桶检测 / 聚类，常用 RANSAC 与区域建模做实时点云处理；车队里负责从感知到规控的工程化与 rosbag 复现实验。',
	'这里记录我在 ROS（C++/Python）、CUDA、PyTorch 上的学习轨迹和项目实践，欢迎通过下方渠道交流。',
];

/** 时间线「现在」段（手动维护；其余按年聚合自项目数据） */
const NOW_ITEM = {
	period: '现在',
	title: '核心成员',
	org: 'FSAC Team of HUAT · https://github.com/HUAT-FSAC',
	desc: '本科生在读，关注 LiDAR 地面分割、自动驾驶赛车算法与 ROS 2 工程化。',
};

/** 联系方式 */
const contactLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'GitHub', href: 'https://github.com/zhangjszs', icon: 'github-logo' },
	{ label: 'Email', href: 'mailto:zhangjszs@foxmail.com', icon: 'envelope' },
	{ label: 'CSDN', href: 'https://blog.csdn.net/zcw_jszs', icon: 'pencil-line' },
	{ label: 'CNBlogs', href: 'https://www.cnblogs.com/jszs0013/', icon: 'globe' },
];

// ============================================================
// B 路线：项目数据自动聚合（不引外部图表库，纯前端聚合 + 现有 RadarChart）
// ============================================================

const allProjects = await getCollection('projects');
// 只看 personal（个人项目），不混入课程实验
const personalProjects = allProjects.filter((p) => p.data.category === 'personal');

// 技术栈关键词到 6 大类（语言/前端/后端/工具/数据/其他）的映射
// 匹配时大小写不敏感、包含匹配（如 "TypeScript" 命中 "typescript"）
const CATEGORY_KEYWORDS: Record<string, string[]> = {
	语言: ['c++', 'c', 'python', 'cuda', 'rust', 'matlab', 'typescript', 'java', 'go'],
	前端: ['html', 'css', 'sass', 'react', 'vue', 'svelte', 'astro', 'vite', 'tailwind', 'webpack', 'figma'],
	后端: [
		'node.js',
		'nodejs',
		'express',
		'django',
		'flask',
		'spring',
		'postgresql',
		'mysql',
		'mongodb',
		'redis',
		'rest',
	],
	工具: ['ros', 'ros2', 'git', 'docker', 'cmake', 'linux', 'ubuntu', 'github actions', 'ci/cd', 'cloudflare', 'aws'],
	数据: [
		'lidar',
		'点云',
		'slam',
		'opencv',
		'eigen',
		'pcl',
		'pytorch',
		'tensorflow',
		'pandas',
		'numpy',
		'matplotlib',
		'jupyter',
	],
	其他: ['自动驾驶', 'fsac', '路径规划', '感知', '定位', '控制', '算法', '数据结构', '网络', '操作系统'],
};

const RADAR_CATEGORY_ORDER: Array<keyof typeof CATEGORY_KEYWORDS> = ['语言', '前端', '后端', '工具', '数据', '其他'];

/** 频次统计：每个技术栈出现次数 */
const techFreq = new Map<string, number>();
personalProjects.forEach((p) => {
	p.data.techStack.forEach((tech) => {
		const key = tech.trim();
		if (key) techFreq.set(key, (techFreq.get(key) || 0) + 1);
	});
});
const allTechSorted = [...techFreq.entries()].sort((a, b) => b[1] - a[1]);

/** 6 类雷达：每类的 level = 该类技术累计频次 / 该类项目数 × 100（封顶 100） */
const radarCategories = RADAR_CATEGORY_ORDER.map((cat) => {
	const kws = CATEGORY_KEYWORDS[cat].map((k) => k.toLowerCase());
	const hits = allTechSorted.filter(([tech]) => kws.some((k) => tech.toLowerCase().includes(k)));
	const skills = hits.slice(0, 3).map(([t]) => t);
	const totalCount = hits.reduce((s, [, c]) => s + c, 0);
	// level 归一化：每类至少要 1 个项目才显示数据；按"累计使用次数 / 项目数"映射到 0-100
	const level =
		personalProjects.length === 0 ? 0 : Math.min(100, Math.round((totalCount / personalProjects.length) * 60 + 20));
	return { category: cat, skills, level };
});

/** 技能分组卡片（按 6 大类聚合） */
const skills = RADAR_CATEGORY_ORDER.map((cat) => {
	const kws = CATEGORY_KEYWORDS[cat].map((k) => k.toLowerCase());
	const items = allTechSorted.filter(([tech]) => kws.some((k) => tech.toLowerCase().includes(k))).map(([t]) => t);
	return { category: cat, items };
}).filter((g) => g.items.length > 0);

/** 时间线：按项目 `date` 字段的年份聚合（最近 5 年） */
const projectsByYear = new Map<string, number>();
personalProjects.forEach((p) => {
	if (p.data.date) {
		const year = p.data.date.split('-')[0];
		if (year) projectsByYear.set(year, (projectsByYear.get(year) || 0) + 1);
	}
});
const recentYears = [...projectsByYear.entries()].sort((a, b) => Number(b[0]) - Number(a[0])).slice(0, 5);

const autoTimeline = recentYears.map(([year, count]) => ({
	period: year,
	title: `${count} 个项目`,
	org: '本站作品集',
	desc: `${year} 年发布的个人项目。`,
}));

// 时间线完整序列：现在 → 倒序年份
const timeline = [NOW_ITEM, ...autoTimeline];
---

<BaseLayout
	title="关于 | Kerwin Zhang"
	description="Kerwin Zhang · 自动驾驶工程学生，FSAC 车队成员，研究方向 LiDAR 感知与自动驾驶算法。"
>
	<section class="hero-section">
		<div class="hero-blobs" aria-hidden="true">
			<div class="blob blob-1"></div>
			<div class="blob blob-2"></div>
		</div>
		<div class="wrapper hero-content">
			<div class="hero-text">
				<span class="eyebrow" data-i18n="about.eyebrow">你好</span>
				<h1 class="hero-title">
					<span data-i18n="about.title">关于</span>
					<span class="gradient-text" data-i18n="about.titleAccent">我</span>
				</h1>
				<p class="hero-tagline" data-i18n="about.tagline">热爱动手实践的开发者，在这里记录成长轨迹。</p>
			</div>
		</div>
	</section>

	<main class="wrapper stack gap-20">
		<!-- Background -->
		<section class="section reveal">
			<div class="about-grid">
				<div class="about-text">
					<span class="section-eyebrow" data-i18n="about.background.eyebrow">背景</span>
					<h2 class="section-title">
						<span data-i18n="about.background.title">我是谁</span>
					</h2>
					<p class="role-line">{ROLE}</p>
					{ABOUT_PARAGRAPHS.map((p) => <p>{p}</p>)}
				</div>
				<div class="timeline">
					{
						timeline.map((item) => (
							<div class="timeline-item">
								<div class="timeline-marker">
									<div class="timeline-dot" />
									<div class="timeline-line" />
								</div>
								<div class="timeline-content">
									<span class="timeline-period">{item.period}</span>
									<h3>{item.title}</h3>
									<p class="timeline-org">{item.org}</p>
									<p>{item.desc}</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Skills -->
		<section class="section section-alt reveal">
			<span class="section-eyebrow" data-i18n="about.skills.eyebrow">能力</span>
			<h2 class="section-title">
				<span data-i18n="about.skills.title">技术</span>
				<span class="gradient-text" data-i18n="about.skills.titleAccent">栈</span>
			</h2>
			<div class="radar-wrapper">
				<RadarChart categories={radarCategories} />
			</div>
			<div class="skills-grid">
				{
					skills.map((group) => (
						<div class="skill-card">
							<h3>{group.category}</h3>
							<div class="skill-items">
								{group.items.map((item) => (
									<span class="skill-item">{item}</span>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- 数据摘要（B 路线：项目数据自动聚合，零图表库） -->
		<section class="section reveal">
			<span class="section-eyebrow">数据</span>
			<h2 class="section-title">
				<span>项目</span>
				<span class="gradient-text">概览</span>
			</h2>
			<p class="data-note">以下数据从 <code>src/content/projects/</code> 自动聚合，每加一个项目都会自动更新。</p>
			<div class="data-grid">
				<div class="data-card">
					<span class="data-number">{personalProjects.length}</span>
					<span class="data-label">个人项目</span>
				</div>
				<div class="data-card">
					<span class="data-number">{allTechSorted.length}</span>
					<span class="data-label">独立技术</span>
				</div>
				<div class="data-card">
					<span class="data-number">{skills.reduce((s, g) => s + g.items.length, 0)}</span>
					<span class="data-label">技术归类</span>
				</div>
				<div class="data-card">
					<span class="data-number">{recentYears.length}</span>
					<span class="data-label">活跃年份</span>
				</div>
			</div>
			{
				allTechSorted.length > 0 && (
					<div class="top-tech">
						<h3>最常使用的技术</h3>
						<ol>
							{allTechSorted.slice(0, 8).map(([tech, count]) => (
								<li>
									<span class="top-tech-name">{tech}</span>
									<span class="top-tech-count">× {count}</span>
								</li>
							))}
						</ol>
					</div>
				)
			}
		</section>

		<!-- Contact -->
		<section class="section section-alt reveal">
			<span class="section-eyebrow" data-i18n="about.contact.eyebrow">联系</span>
			<h2 class="section-title">
				<span data-i18n="about.contact.title">联系</span>
				<span class="gradient-text" data-i18n="about.contact.titleAccent">方式</span>
			</h2>
			<p class="contact-desc" data-i18n="about.contact.desc">欢迎通过以下渠道与我交流，无论是技术讨论还是合作机会。</p>
			<div class="contact-grid">
				{
					contactLinks.map((link) => (
						<a
							class="contact-card"
							href={link.href}
							target={link.href.startsWith('http') ? '_blank' : undefined}
							rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
						>
							<Icon icon={link.icon} size="1.5em" />
							<span class="contact-label">{link.label}</span>
						</a>
					))
				}
			</div>
		</section>
	</main>

	<style>
		/* ===== Hero ===== */
		.hero-section {
			position: relative;
			padding: 6rem 0 5rem;
			overflow: hidden;
			margin-bottom: 3rem;
		}

		.hero-blobs {
			position: absolute;
			inset: 0;
			z-index: 0;
			pointer-events: none;
		}

		.blob {
			position: absolute;
			border-radius: 50%;
			filter: blur(100px);
			opacity: 0.3;
		}

		.blob-1 {
			width: 450px;
			height: 450px;
			background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
			top: -20%;
			left: 10%;
			animation: float 12s ease-in-out infinite;
		}

		.blob-2 {
			width: 350px;
			height: 350px;
			background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
			bottom: -10%;
			right: 10%;
			animation: float 14s ease-in-out infinite reverse;
		}

		.hero-content {
			position: relative;
			z-index: 1;
			text-align: center;
		}

		.hero-text {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			align-items: center;
		}

		.eyebrow {
			font-size: var(--text-sm);
			font-weight: 600;
			color: var(--accent-regular);
			text-transform: uppercase;
			letter-spacing: 0.1em;
		}

		.hero-title {
			font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
			font-weight: 800;
			color: var(--gray-0);
			line-height: 1.1;
			margin: 0;
		}

		.hero-tagline {
			font-size: var(--text-lg);
			color: var(--gray-300);
			max-width: 55ch;
			line-height: 1.6;
			margin: 0;
		}

		/* ===== Sections ===== */
		.section {
			padding: 2rem 0;
		}

		.section-alt {
			background: var(--gray-900);
			border-top: 1px solid var(--gray-800);
			border-bottom: 1px solid var(--gray-800);
			padding: 4rem 1.5rem;
			margin: 0 -1.5rem;
		}

		.section-eyebrow {
			display: block;
			font-size: var(--text-sm);
			font-weight: 600;
			color: var(--accent-regular);
			text-transform: uppercase;
			letter-spacing: 0.1em;
			margin-bottom: 0.5rem;
		}

		.section-title {
			font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
			margin-bottom: 2rem;
			color: var(--gray-0);
		}

		/* ===== About Grid ===== */
		.about-grid {
			display: grid;
			gap: 3rem;
			grid-template-columns: 1fr;
		}

		.about-text {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		.about-text p {
			color: var(--gray-300);
			line-height: 1.7;
			margin: 0;
		}

		/* 身份标签（莫兰迪点缀） */
		.role-line {
			display: inline-block;
			padding: 0.35rem 0.85rem;
			border-radius: 999px;
			background: var(--accent-overlay);
			color: var(--accent-dark);
			font-size: var(--text-sm);
			font-weight: 500;
			letter-spacing: 0.02em;
			margin-bottom: 0.25rem;
		}

		/* ===== 数据摘要（B 路线） ===== */
		.data-note {
			color: var(--gray-400);
			font-size: var(--text-sm);
			margin: 0 0 1.25rem;
		}
		.data-note code {
			font-family: var(--font-mono);
			font-size: 0.85em;
			padding: 0.1em 0.4em;
			background: var(--gray-800);
			border-radius: 4px;
		}
		.data-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1rem;
			margin-bottom: 2rem;
		}
		@media (min-width: 50em) {
			.data-grid {
				grid-template-columns: repeat(4, 1fr);
			}
		}
		.data-card {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			padding: 1.25rem 1rem;
			border: 1px solid var(--gray-700);
			border-radius: 12px;
			background: var(--gray-900);
			transition: border-color 0.2s;
		}
		.data-card:hover {
			border-color: var(--accent-regular);
		}
		.data-number {
			font-family: var(--font-brand);
			font-size: var(--text-3xl);
			font-weight: 700;
			color: var(--accent-regular);
		}
		.data-label {
			font-size: var(--text-sm);
			color: var(--gray-400);
		}
		.top-tech h3 {
			font-size: var(--text-lg);
			margin: 0 0 0.75rem;
			color: var(--gray-100);
		}
		.top-tech ol {
			list-style: none;
			padding: 0;
			margin: 0;
			display: grid;
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
		@media (min-width: 40em) {
			.top-tech ol {
				grid-template-columns: repeat(2, 1fr);
			}
		}
		.top-tech li {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 0.6rem 0.9rem;
			background: var(--gray-900);
			border: 1px solid var(--gray-700);
			border-radius: 8px;
			font-size: var(--text-sm);
		}
		.top-tech-name {
			color: var(--gray-100);
			font-weight: 500;
		}
		.top-tech-count {
			color: var(--accent-regular);
			font-family: var(--font-mono);
			font-size: 0.85em;
		}

		/* ===== Timeline ===== */
		.timeline {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
		}

		.timeline-item {
			display: flex;
			gap: 1rem;
		}

		.timeline-marker {
			display: flex;
			flex-direction: column;
			align-items: center;
			flex-shrink: 0;
		}

		.timeline-dot {
			width: 12px;
			height: 12px;
			border-radius: 50%;
			background: var(--accent-regular);
			box-shadow: 0 0 0 4px var(--accent-subtle-overlay);
		}

		.timeline-line {
			width: 2px;
			flex: 1;
			background: var(--gray-800);
			margin-top: 0.5rem;
		}

		.timeline-item:last-child .timeline-line {
			display: none;
		}

		.timeline-content {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			padding-bottom: 1.5rem;
		}

		.timeline-period {
			font-size: var(--text-sm);
			font-weight: 600;
			color: var(--accent-regular);
		}

		.timeline-content h3 {
			font-size: var(--text-lg);
			color: var(--gray-0);
			margin: 0;
		}

		.timeline-org {
			font-size: var(--text-sm);
			color: var(--gray-400);
			margin: 0;
		}

		.timeline-content p {
			color: var(--gray-300);
			line-height: 1.5;
			margin: 0.25rem 0 0;
			font-size: var(--text-sm);
		}

		/* ===== Radar Chart ===== */
		.radar-wrapper {
			display: flex;
			justify-content: center;
			margin-bottom: 2.5rem;
		}

		/* ===== Skills Grid ===== */
		.skills-grid {
			display: grid;
			gap: 1.5rem;
			grid-template-columns: 1fr;
		}

		.skill-card {
			padding: 1.5rem;
			background: var(--gray-999);
			border: 1px solid var(--gray-800);
			border-radius: 1rem;
			transition:
				transform 0.3s ease,
				box-shadow 0.3s ease,
				border-color 0.3s ease;
		}

		.skill-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
			border-color: var(--accent-regular);
		}

		.skill-card h3 {
			font-size: var(--text-sm);
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--gray-400);
			margin-bottom: 1rem;
		}

		.skill-items {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.skill-item {
			padding: 0.35rem 0.8rem;
			background: var(--gray-800);
			color: var(--gray-200);
			border-radius: 0.375rem;
			font-size: var(--text-sm);
			border: 1px solid var(--gray-700);
			transition: all 0.2s ease;
		}

		.skill-item:hover {
			background: var(--accent-regular);
			color: var(--gray-999);
			border-color: var(--accent-regular);
			transform: translateY(-2px);
		}

		/* ===== Contact ===== */
		.contact-desc {
			color: var(--gray-300);
			line-height: 1.6;
			margin: 0 0 2rem;
		}

		.contact-grid {
			display: grid;
			gap: 1.25rem;
			grid-template-columns: repeat(2, 1fr);
			max-width: 40rem;
		}

		.contact-card {
			display: flex;
			align-items: center;
			gap: 0.9rem;
			padding: 1.25rem 1.5rem;
			background: var(--gray-999);
			border: 1px solid var(--gray-800);
			border-radius: 1rem;
			color: var(--gray-200);
			text-decoration: none;
			transition:
				transform 0.3s ease,
				border-color 0.3s ease,
				box-shadow 0.3s ease;
