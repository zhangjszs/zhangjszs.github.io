---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { iconPaths } from '../components/IconPaths';
import PageHeader from '../components/PageHeader.astro';
import RadarChart from '../components/RadarChart.astro';
import { UPDATES, UPDATE_TYPE_LABEL } from '../data/updates';

// ============================================================
// 静态个人信息（站名、身份、时间线"现在"段、联系方式）
// 改这里就行；下面的"技能/标签/时间线"是项目数据自动聚合的
// ============================================================

/** 身份标签 */
const ROLE = '自动驾驶工程学生 / 湖北汽车工业学院 FSAC 车队';

/** 个人简介段落（出现在 About 背景区，可写多段） */
const ABOUT_PARAGRAPHS: string[] = [
	'我是 Kerwin Zhang，湖北汽车工业学院的本科生，目前在 FSAC 车队做自动驾驶相关工作，方向覆盖感知、定位、规划与控制全流程。',
	'研究兴趣集中在 LiDAR 地面分割与锥桶检测 / 聚类，常用 RANSAC 与区域建模做实时点云处理；车队里负责从感知到规控的工程化与 rosbag 复现实验。',
	'这里记录我在 ROS（C++/Python）、CUDA、PyTorch 上的学习轨迹和项目实践，欢迎通过下方渠道交流。',
];

/** 时间线「现在」段（手动维护；其余按年聚合自项目数据） */
const NOW_ITEM = {
	period: '现在',
	title: '核心成员',
	org: 'FSAC Team of HUAT · https://github.com/HUAT-FSAC',
	desc: '本科生在读，关注 LiDAR 地面分割、自动驾驶赛车算法与 ROS 2 工程化。',
};

/** 联系方式 */
const contactLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'GitHub', href: 'https://github.com/zhangjszs', icon: 'github-logo' },
	{ label: 'Email', href: 'mailto:zhangjszs@foxmail.com', icon: 'envelope' },
	{ label: 'CSDN', href: 'https://blog.csdn.net/zcw_jszs', icon: 'pencil-line' },
	{ label: '博客园', href: 'https://www.cnblogs.com/jszs0013/', icon: 'globe' },
];

/** GitHub 贡献热力图（ghchart 免费服务，失效时图片 onerror 自动隐藏整个区块） */
const GITHUB_USERNAME = 'zhangjszs';

// ============================================================
// 项目数据自动聚合（不引外部图表库，纯前端聚合 + 现有 RadarChart）
// ============================================================

const allProjects = await getCollection('projects');
// 只看 personal（个人项目），不混入课程实验
const personalProjects = allProjects.filter((p) => p.data.category === 'personal');

// 技术栈关键词到 6 大类（语言/前端/后端/工具/数据/其他）的映射
// 匹配时大小写不敏感、包含匹配（如 "TypeScript" 命中 "typescript"）
const CATEGORY_KEYWORDS: Record<string, string[]> = {
	语言: ['c++', 'c', 'python', 'cuda', 'rust', 'matlab', 'typescript', 'java', 'go'],
	前端: ['html', 'css', 'sass', 'react', 'vue', 'svelte', 'astro', 'vite', 'tailwind', 'webpack', 'figma'],
	后端: [
		'node.js',
		'nodejs',
		'express',
		'django',
		'flask',
		'spring',
		'postgresql',
		'mysql',
		'mongodb',
		'redis',
		'rest',
	],
	工具: ['ros', 'ros2', 'git', 'docker', 'cmake', 'linux', 'ubuntu', 'github actions', 'ci/cd', 'cloudflare', 'aws'],
	数据: [
		'lidar',
		'点云',
		'slam',
		'opencv',
		'eigen',
		'pcl',
		'pytorch',
		'tensorflow',
		'pandas',
		'numpy',
		'matplotlib',
		'jupyter',
	],
	其他: ['自动驾驶', 'fsac', '路径规划', '感知', '定位', '控制', '算法', '数据结构', '网络', '操作系统'],
};

const RADAR_CATEGORY_ORDER: Array<keyof typeof CATEGORY_KEYWORDS> = ['语言', '前端', '后端', '工具', '数据', '其他'];

/** 频次统计：每个技术栈出现次数 */
const techFreq = new Map<string, number>();
personalProjects.forEach((p) => {
	p.data.techStack.forEach((tech) => {
		const key = tech.trim();
		if (key) techFreq.set(key, (techFreq.get(key) || 0) + 1);
	});
});
const allTechSorted = [...techFreq.entries()].sort((a, b) => b[1] - a[1]);

/** 6 类雷达：每类的 level = 该类技术累计频次 / 该类项目数 × 100（封顶 100） */
const radarCategories = RADAR_CATEGORY_ORDER.map((cat) => {
	const kws = CATEGORY_KEYWORDS[cat].map((k) => k.toLowerCase());
	const hits = allTechSorted.filter(([tech]) => kws.some((k) => tech.toLowerCase().includes(k)));
	const skills = hits.slice(0, 3).map(([t]) => t);
	const totalCount = hits.reduce((s, [, c]) => s + c, 0);
	const level =
		personalProjects.length === 0 ? 0 : Math.min(100, Math.round((totalCount / personalProjects.length) * 60 + 20));
	return { category: cat, skills, level };
});

/** 技能分组卡片（按 6 大类聚合） */
const skills = RADAR_CATEGORY_ORDER.map((cat) => {
	const kws = CATEGORY_KEYWORDS[cat].map((k) => k.toLowerCase());
	const items = allTechSorted.filter(([tech]) => kws.some((k) => tech.toLowerCase().includes(k))).map(([t]) => t);
	return { category: cat, items };
}).filter((g) => g.items.length > 0);

/** 时间线：按项目 `date` 字段的年份聚合（最近 5 年） */
const projectsByYear = new Map<string, number>();
personalProjects.forEach((p) => {
	if (p.data.date) {
		const year = p.data.date.split('-')[0];
		if (year) projectsByYear.set(year, (projectsByYear.get(year) || 0) + 1);
	}
});
const recentYears = [...projectsByYear.entries()].sort((a, b) => Number(b[0]) - Number(a[0])).slice(0, 5);

const autoTimeline = recentYears.map(([year, count]) => ({
	period: year,
	title: `${count} 个项目`,
	org: '本站作品集',
	desc: `${year} 年发布的个人项目。`,
}));

// 时间线完整序列：现在 → 倒序年份
const timeline = [NOW_ITEM, ...autoTimeline];
---

<BaseLayout
	title="关于 | Kerwin Zhang"
	description="Kerwin Zhang · 自动驾驶工程学生，FSAC 车队成员，研究方向 LiDAR 感知与自动驾驶算法。"
>
	<div class="wrapper" data-pagefind-body>
		<PageHeader eyebrow="03 · about" title="关于我" description={ROLE} />

		<!-- 01 背景 -->
		<section class="section" data-reveal>
			<span class="section-eyebrow">01 · 背景</span>
			<h2 class="section-title">我是谁</h2>
			<div class="about-grid">
				<div class="about-text">
					{ABOUT_PARAGRAPHS.map((p) => <p>{p}</p>)}
				</div>
				<div class="timeline">
					{
						timeline.map((item) => (
							<div class="timeline-item">
								<div class="timeline-marker">
									<div class="timeline-dot" />
									<div class="timeline-line" />
								</div>
								<div class="timeline-content">
									<span class="timeline-period">{item.period}</span>
									<h3>{item.title}</h3>
									<p class="timeline-org">{item.org}</p>
									<p>{item.desc}</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- 02 技能 -->
		<section class="section" data-reveal>
			<span class="section-eyebrow">02 · 技能</span>
			<h2 class="section-title">技术雷达</h2>
			<div class="radar-wrapper">
				<RadarChart categories={radarCategories} />
			</div>
			<div class="skills-grid">
				{
					skills.map((group) => (
						<div class="skill-card">
							<h3>{group.category}</h3>
							<div class="skill-items">
								{group.items.map((item) => (
									<span class="skill-item">{item}</span>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- 03 GitHub 贡献热力图 -->
		<section class="section" data-reveal id="heatmap-section">
			<span class="section-eyebrow">03 · 轨迹</span>
			<h2 class="section-title">GitHub 贡献</h2>
			<div class="heatmap-card">
				<img
					src={`https://ghchart.rshah.org/3fe0a1/${GITHUB_USERNAME}`}
					alt={`${GITHUB_USERNAME} 的 GitHub 贡献热力图`}
					loading="lazy"
					onerror="document.getElementById('heatmap-section')?.remove()"
				/>
			</div>
		</section>

		<!-- 04 数据概览 -->
		{
			allTechSorted.length > 0 && (
				<section class="section" data-reveal>
					<span class="section-eyebrow">04 · 数据</span>
					<h2 class="section-title">项目概览</h2>
					<div class="data-grid">
						<div class="data-card">
							<span class="data-number">{personalProjects.length}</span>
							<span class="data-label">个人项目</span>
						</div>
						<div class="data-card">
							<span class="data-number">{allTechSorted.length}</span>
							<span class="data-label">独立技术</span>
						</div>
						<div class="data-card">
							<span class="data-number">{skills.reduce((s, g) => s + g.items.length, 0)}</span>
							<span class="data-label">技术归类</span>
						</div>
						<div class="data-card">
							<span class="data-number">{recentYears.length}</span>
							<span class="data-label">活跃年份</span>
						</div>
					</div>
				</section>
			)
		}

		<!-- 05 站点更新日志 -->
		<section class="section" data-reveal>
			<span class="section-eyebrow">05 · 更新</span>
			<h2 class="section-title">站点动态</h2>
			<div class="updates">
				{
					UPDATES.map((u) => (
						<div class="update-row">
							<time datetime={u.date}>{u.date}</time>
							<span class={`update-type update-type-${u.type}`}>{UPDATE_TYPE_LABEL[u.type]}</span>
							<span class="update-title">{u.title}</span>
						</div>
					))
				}
			</div>
		</section>

		<!-- 06 联系 -->
		<section class="section" data-reveal>
			<span class="section-eyebrow">06 · 联系</span>
			<h2 class="section-title">联系方式</h2>
			<p class="contact-desc">欢迎通过以下渠道与我交流，无论是技术讨论还是合作机会。</p>
			<div class="contact-grid">
				{
					contactLinks.map((link) => (
						<a
							class="contact-card"
							href={link.href}
							target={link.href.startsWith('http') ? '_blank' : undefined}
							rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
						>
							<Icon icon={link.icon} size="1.4em" />
							<span class="contact-label">{link.label}</span>
						</a>
					))
				}
			</div>
		</section>
		<div class="page-end"></div>
	</div>

	<script>
		import { initMotion } from '../scripts/motion/core';
		initMotion();
	</script>

	<style>
		.section {
			display: flex;
			flex-direction: column;
			gap: 1.25rem;
			padding: clamp(2.5rem, 6vw, 4rem) 0;
			border-top: 1px solid var(--border);
		}

		.section:first-of-type {
			border-top: 0;
		}

		.section-eyebrow {
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			color: var(--accent);
			letter-spacing: 0.08em;
		}

		.section-title {
			font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
			margin: 0 0 1.25rem;
		}

		/* ===== 背景 ===== */
		.about-grid {
			display: grid;
			gap: 2.5rem;
			grid-template-columns: 1fr;
		}

		.about-text {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		.about-text p {
			color: var(--muted-foreground);
			line-height: 1.9;
			margin: 0;
			font-size: var(--text-md);
		}

		/* ===== 时间线 ===== */
		.timeline {
			display: flex;
			flex-direction: column;
			gap: 0;
		}

		.timeline-item {
			display: flex;
			gap: 1rem;
		}

		.timeline-marker {
			display: flex;
			flex-direction: column;
			align-items: center;
			flex-shrink: 0;
		}

		.timeline-dot {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: var(--accent);
			box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
		}

		.timeline-line {
			width: 1px;
			flex: 1;
			background: var(--border);
			margin-top: 0.5rem;
		}

		.timeline-item:last-child .timeline-line {
			display: none;
		}

		.timeline-content {
			display: flex;
			flex-direction: column;
			gap: 0.2rem;
			padding-bottom: 1.5rem;
		}

		.timeline-period {
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			color: var(--accent);
		}

		.timeline-content h3 {
			font-size: var(--text-base);
			margin: 0;
		}

		.timeline-org {
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			color: var(--muted-foreground);
			margin: 0;
			overflow-wrap: anywhere;
		}

		.timeline-content p:last-child {
			color: var(--muted-foreground);
			line-height: 1.6;
			margin: 0.25rem 0 0;
			font-size: var(--text-sm);
		}

		/* ===== 技能 ===== */
		.radar-wrapper {
			display: flex;
			justify-content: center;
			margin-bottom: 2rem;
		}

		.skills-grid {
			display: grid;
			gap: 1.25rem;
			grid-template-columns: 1fr;
		}

		.skill-card {
			padding: 1.25rem 1.5rem;
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-md);
		}

		.skill-card h3 {
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			font-weight: 500;
			color: var(--muted-foreground);
			margin: 0 0 0.9rem;
			letter-spacing: 0.05em;
		}

		.skill-items {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.skill-item {
			padding: 0.3rem 0.75rem;
			background: var(--muted);
			color: var(--foreground);
			border: 1px solid var(--border);
			border-radius: var(--radius-sm);
			font-size: var(--text-sm);
			font-family: var(--font-mono);
			transition:
				color 0.2s var(--ease-out),
				border-color 0.2s var(--ease-out);
		}

		.skill-item:hover {
			color: var(--accent);
			border-color: var(--accent);
		}

		/* ===== 热力图 ===== */
		.heatmap-card {
			padding: 1.5rem;
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-md);
			overflow-x: auto;
		}

		.heatmap-card img {
			width: 100%;
			min-width: 560px;
			display: block;
			border: 0;
		}

		/* ===== 数据 ===== */
		.data-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1rem;
		}

		.data-card {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			padding: 1.25rem 1.25rem;
			border: 1px solid var(--border);
			border-radius: var(--radius-md);
			background: var(--surface);
			transition: border-color 0.2s var(--ease-out);
		}

		.data-card:hover {
			border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
		}

		.data-number {
			font-family: var(--font-brand);
			font-size: var(--text-3xl);
			font-weight: 700;
			color: var(--accent);
			line-height: 1.1;
		}

		.data-label {
			font-size: var(--text-sm);
			color: var(--muted-foreground);
		}

		/* ===== 更新日志 ===== */
		.updates {
			display: flex;
			flex-direction: column;
			border-top: 1px solid var(--border);
		}

		.update-row {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem 1.25rem;
			align-items: baseline;
			padding: 1rem 0;
			border-bottom: 1px solid var(--border);
			font-size: var(--text-sm);
		}

		.update-row time {
			font-family: var(--font-mono);
			color: var(--muted-foreground);
			flex-shrink: 0;
		}

		.update-type {
			padding: 0.1rem 0.6rem;
			border-radius: var(--radius-full);
			font-size: var(--text-xs);
			font-weight: 600;
			flex-shrink: 0;
		}

		.update-type-design {
			background: color-mix(in srgb, var(--accent) 14%, transparent);
			color: var(--accent);
		}

		.update-type-feature {
			background: color-mix(in srgb, var(--accent-warm) 16%, transparent);
			color: var(--accent-warm);
		}

		.update-type-content {
			background: var(--muted);
			color: var(--foreground);
		}

		.update-type-fix {
			background: var(--muted);
			color: var(--muted-foreground);
		}

		.update-title {
			color: var(--foreground);
			line-height: 1.6;
		}

		/* ===== 联系 ===== */
		.contact-desc {
			color: var(--muted-foreground);
			line-height: 1.7;
			margin: 0 0 1.5rem;
			max-width: 56ch;
		}

		.contact-grid {
			display: grid;
			gap: 1rem;
			grid-template-columns: repeat(2, 1fr);
			max-width: 40rem;
		}

		.contact-card {
			display: flex;
			align-items: center;
			gap: 0.9rem;
			padding: 1.1rem 1.4rem;
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-md);
			color: var(--foreground);
			text-decoration: none;
			transition:
				transform 0.25s var(--ease-out),
				border-color 0.25s var(--ease-out),
				box-shadow 0.25s var(--ease-out);
		}

		.contact-card:hover {
			transform: translateY(-3px);
			border-color: var(--accent);
			box-shadow: var(--glow-accent);
		}

		.contact-card :global(svg) {
			color: var(--accent);
		}

		.contact-label {
			font-weight: 600;
			font-size: var(--text-sm);
		}

		.page-end {
			height: clamp(3rem, 8vw, 6rem);
		}

		@media (min-width: 50em) {
			.about-grid {
				grid-template-columns: 1fr 1fr;
				gap: 4rem;
				align-items: start;
			}

			.skills-grid {
				grid-template-columns: repeat(2, 1fr);
			}

			.data-grid {
				grid-template-columns: repeat(4, 1fr);
			}
		}

		@media (min-width: 70em) {
			.skills-grid {
				grid-template-columns: repeat(3, 1fr);
			}
		}

		@media (max-width: 40em) {
			.contact-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>
</BaseLayout>
