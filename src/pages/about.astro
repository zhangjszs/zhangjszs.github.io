---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { iconPaths } from '../components/IconPaths';
import RadarChart from '../components/RadarChart.astro';

// ============================================================
// TODO: 以下个人信息全部为占位内容，请替换为你自己的资料
// ============================================================

// 技能雷达图数据（level 为 0-100 的自评分数）
const radarCategories = [
	{ category: '语言', skills: ['Java', 'Python', 'TypeScript'], level: 85 },
	{ category: '前端', skills: ['HTML/CSS', 'React', 'Astro'], level: 75 },
	{ category: '后端', skills: ['Node.js', 'SQL', 'API 设计'], level: 80 },
	{ category: '工具', skills: ['Git', 'Linux', 'Docker'], level: 70 },
	{ category: '数据', skills: ['Pandas', 'SQL', '可视化'], level: 65 },
	{ category: '其他', skills: ['算法', '网络', '设计'], level: 60 },
];

// 技能分组
const skills = [
	{ category: '语言', items: ['Java', 'Python', 'TypeScript', 'SQL'] },
	{ category: '前端', items: ['HTML/CSS', 'Astro', 'React', 'Vite'] },
	{ category: '后端', items: ['Node.js', 'REST API', 'PostgreSQL'] },
	{ category: '工具', items: ['Git', 'Linux', 'Docker', 'CI/CD'] },
];

// 个人时间线
const timeline = [
	{
		period: '现在',
		title: '开发者 / 学生',
		org: 'TODO: 你的学校或公司',
		desc: 'TODO: 一句话介绍你当前的状态与方向。',
	},
	{
		period: '过往',
		title: '课程实验与个人项目',
		org: '本站作品集',
		desc: '完成了数据结构、算法、Web 开发等多个方向的课程实验，并持续维护个人项目。',
	},
];

// 联系方式（TODO: 替换为你自己的链接）
const contactLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'GitHub', href: 'https://github.com/your-username', icon: 'github-logo' },
	{ label: 'Email', href: 'mailto:your-email@example.com', icon: 'envelope' },
];
---

<BaseLayout title="关于 | 你的名字" description="关于我：个人简介、技能与联系方式。">
	<section class="hero-section">
		<div class="hero-blobs" aria-hidden="true">
			<div class="blob blob-1"></div>
			<div class="blob blob-2"></div>
		</div>
		<div class="wrapper hero-content">
			<div class="hero-text">
				<span class="eyebrow" data-i18n="about.eyebrow">你好</span>
				<h1 class="hero-title">
					<span data-i18n="about.title">关于</span>
					<span class="gradient-text" data-i18n="about.titleAccent">我</span>
				</h1>
				<p class="hero-tagline" data-i18n="about.tagline">热爱动手实践的开发者，在这里记录成长轨迹。</p>
			</div>
		</div>
	</section>

	<main class="wrapper stack gap-20">
		<!-- Background -->
		<section class="section reveal">
			<div class="about-grid">
				<div class="about-text">
					<span class="section-eyebrow" data-i18n="about.background.eyebrow">背景</span>
					<h2 class="section-title">
						<span data-i18n="about.background.title">我是谁</span>
					</h2>
					<!-- TODO: 替换为你的个人简介 -->
					<p>我是「你的名字」，一名对软件工程充满热情的开发者。这个网站收录了我的个人项目、课程实验与博客文章。</p>
					<p>
						我相信在实践中学习。这里的每个项目都代表了我解决过的真实问题、探索过的技术，或者曾经难以理解最终掌握的概念。
					</p>
				</div>
				<div class="timeline">
					{
						timeline.map((item) => (
							<div class="timeline-item">
								<div class="timeline-marker">
									<div class="timeline-dot" />
									<div class="timeline-line" />
								</div>
								<div class="timeline-content">
									<span class="timeline-period">{item.period}</span>
									<h3>{item.title}</h3>
									<p class="timeline-org">{item.org}</p>
									<p>{item.desc}</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Skills -->
		<section class="section section-alt reveal">
			<span class="section-eyebrow" data-i18n="about.skills.eyebrow">能力</span>
			<h2 class="section-title">
				<span data-i18n="about.skills.title">技术</span>
				<span class="gradient-text" data-i18n="about.skills.titleAccent">栈</span>
			</h2>
			<div class="radar-wrapper">
				<RadarChart categories={radarCategories} />
			</div>
			<div class="skills-grid">
				{
					skills.map((group) => (
						<div class="skill-card">
							<h3>{group.category}</h3>
							<div class="skill-items">
								{group.items.map((item) => (
									<span class="skill-item">{item}</span>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- Contact -->
		<section class="section section-alt reveal">
			<span class="section-eyebrow" data-i18n="about.contact.eyebrow">联系</span>
			<h2 class="section-title">
				<span data-i18n="about.contact.title">联系</span>
				<span class="gradient-text" data-i18n="about.contact.titleAccent">方式</span>
			</h2>
			<p class="contact-desc" data-i18n="about.contact.desc">欢迎通过以下渠道与我交流，无论是技术讨论还是合作机会。</p>
			<div class="contact-grid">
				{
					contactLinks.map((link) => (
						<a
							class="contact-card"
							href={link.href}
							target={link.href.startsWith('http') ? '_blank' : undefined}
							rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
						>
							<Icon icon={link.icon} size="1.5em" />
							<span class="contact-label">{link.label}</span>
						</a>
					))
				}
			</div>
		</section>
	</main>

	<style>
		/* ===== Hero ===== */
		.hero-section {
			position: relative;
			padding: 6rem 0 5rem;
			overflow: hidden;
			margin-bottom: 3rem;
		}

		.hero-blobs {
			position: absolute;
			inset: 0;
			z-index: 0;
			pointer-events: none;
		}

		.blob {
			position: absolute;
			border-radius: 50%;
			filter: blur(100px);
			opacity: 0.3;
		}

		.blob-1 {
			width: 450px;
			height: 450px;
			background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
			top: -20%;
			left: 10%;
			animation: float 12s ease-in-out infinite;
		}

		.blob-2 {
			width: 350px;
			height: 350px;
			background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
			bottom: -10%;
			right: 10%;
			animation: float 14s ease-in-out infinite reverse;
		}

		.hero-content {
			position: relative;
			z-index: 1;
			text-align: center;
		}

		.hero-text {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			align-items: center;
		}

		.eyebrow {
			font-size: var(--text-sm);
			font-weight: 600;
			color: var(--accent-regular);
			text-transform: uppercase;
			letter-spacing: 0.1em;
		}

		.hero-title {
			font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
			font-weight: 800;
			color: var(--gray-0);
			line-height: 1.1;
			margin: 0;
		}

		.hero-tagline {
			font-size: var(--text-lg);
			color: var(--gray-300);
			max-width: 55ch;
			line-height: 1.6;
			margin: 0;
		}

		/* ===== Sections ===== */
		.section {
			padding: 2rem 0;
		}

		.section-alt {
			background: var(--gray-900);
			border-top: 1px solid var(--gray-800);
			border-bottom: 1px solid var(--gray-800);
			padding: 4rem 1.5rem;
			margin: 0 -1.5rem;
		}

		.section-eyebrow {
			display: block;
			font-size: var(--text-sm);
			font-weight: 600;
			color: var(--accent-regular);
			text-transform: uppercase;
			letter-spacing: 0.1em;
			margin-bottom: 0.5rem;
		}

		.section-title {
			font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
			margin-bottom: 2rem;
			color: var(--gray-0);
		}

		/* ===== About Grid ===== */
		.about-grid {
			display: grid;
			gap: 3rem;
			grid-template-columns: 1fr;
		}

		.about-text {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		.about-text p {
			color: var(--gray-300);
			line-height: 1.7;
			margin: 0;
		}

		/* ===== Timeline ===== */
		.timeline {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
		}

		.timeline-item {
			display: flex;
			gap: 1rem;
		}

		.timeline-marker {
			display: flex;
			flex-direction: column;
			align-items: center;
			flex-shrink: 0;
		}

		.timeline-dot {
			width: 12px;
			height: 12px;
			border-radius: 50%;
			background: var(--accent-regular);
			box-shadow: 0 0 0 4px var(--accent-subtle-overlay);
		}

		.timeline-line {
			width: 2px;
			flex: 1;
			background: var(--gray-800);
			margin-top: 0.5rem;
		}

		.timeline-item:last-child .timeline-line {
			display: none;
		}

		.timeline-content {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			padding-bottom: 1.5rem;
		}

		.timeline-period {
			font-size: var(--text-sm);
			font-weight: 600;
			color: var(--accent-regular);
		}

		.timeline-content h3 {
			font-size: var(--text-lg);
			color: var(--gray-0);
			margin: 0;
		}

		.timeline-org {
			font-size: var(--text-sm);
			color: var(--gray-400);
			margin: 0;
		}

		.timeline-content p {
			color: var(--gray-300);
			line-height: 1.5;
			margin: 0.25rem 0 0;
			font-size: var(--text-sm);
		}

		/* ===== Radar Chart ===== */
		.radar-wrapper {
			display: flex;
			justify-content: center;
			margin-bottom: 2.5rem;
		}

		/* ===== Skills Grid ===== */
		.skills-grid {
			display: grid;
			gap: 1.5rem;
			grid-template-columns: 1fr;
		}

		.skill-card {
			padding: 1.5rem;
			background: var(--gray-999);
			border: 1px solid var(--gray-800);
			border-radius: 1rem;
			transition:
				transform 0.3s ease,
				box-shadow 0.3s ease,
				border-color 0.3s ease;
		}

		.skill-card:hover {
			transform: translateY(-4px);
			box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
			border-color: var(--accent-regular);
		}

		.skill-card h3 {
			font-size: var(--text-sm);
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--gray-400);
			margin-bottom: 1rem;
		}

		.skill-items {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.skill-item {
			padding: 0.35rem 0.8rem;
			background: var(--gray-800);
			color: var(--gray-200);
			border-radius: 0.375rem;
			font-size: var(--text-sm);
			border: 1px solid var(--gray-700);
			transition: all 0.2s ease;
		}

		.skill-item:hover {
			background: var(--accent-regular);
			color: var(--gray-999);
			border-color: var(--accent-regular);
			transform: translateY(-2px);
		}

		/* ===== Contact ===== */
		.contact-desc {
			color: var(--gray-300);
			line-height: 1.6;
			margin: 0 0 2rem;
		}

		.contact-grid {
			display: grid;
			gap: 1.25rem;
			grid-template-columns: repeat(2, 1fr);
			max-width: 40rem;
		}

		.contact-card {
			display: flex;
			align-items: center;
			gap: 0.9rem;
			padding: 1.25rem 1.5rem;
			background: var(--gray-999);
			border: 1px solid var(--gray-800);
			border-radius: 1rem;
			color: var(--gray-200);
			text-decoration: none;
			transition:
				transform 0.3s ease,
				border-color 0.3s ease,
				box-shadow 0.3s ease;
		}

		.contact-card:hover {
			transform: translateY(-4px);
			border-color: var(--accent-regular);
			box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
		}

		.contact-card :global(svg) {
			color: var(--accent-regular);
		}

		.contact-label {
			font-weight: 600;
			font-size: var(--text-md);
		}

		@media (max-width: 40em) {
			.contact-grid {
				grid-template-columns: 1fr;
			}
		}

		@media (min-width: 50em) {
			.hero-section {
				padding: 8rem 0 6rem;
			}

			.about-grid {
				grid-template-columns: 1fr 1fr;
				gap: 4rem;
				align-items: start;
			}

			.skills-grid {
				grid-template-columns: repeat(2, 1fr);
			}

			.section-alt {
				padding: 4rem 2.5rem;
				margin: 0 -2.5rem;
			}
		}

		@media (min-width: 70em) {
			.skills-grid {
				grid-template-columns: repeat(3, 1fr);
			}
		}
	</style>
</BaseLayout>
