---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { withBase } from '../utils/paths';
import { CONTACT, SITE_NAME, SITE_ROLE } from '../data/site';
import { RESUME } from '../data/resume';

const sections = [
	{ id: 'works', label: '作品' },
	{ id: 'timeline', label: '履历' },
	{ id: 'skills', label: '技能' },
	{ id: 'contact', label: '联系' },
];

const allProjects = await getCollection('projects');
// 个人项目排在前面，课程实验（labwork）靠后
const orderedProjects = [...allProjects].sort((a, b) => {
	if (a.data.category !== b.data.category) return a.data.category === 'personal' ? -1 : 1;
	return 0;
});
const featuredPool = orderedProjects.filter((p) => p.data.featured);
const showcase = (featuredPool.length > 0 ? featuredPool : orderedProjects).slice(0, 4);

// 展开面板直接复用作品正文（## 项目背景 / ## 技术方案 / ## 成果与数据）
const works = await Promise.all(
	showcase.map(async (project, i) => ({
		project,
		index: i + 1,
		Body: (await render(project)).Content,
	}))
);

const shortName = (title: string) => title.split('—')[0].trim();

const yearRows = (() => {
	const map = new Map<string, string[]>();
	for (const project of orderedProjects) {
		const year = (project.data.date ?? '').split('-')[0] || '待补充';
		map.set(year, [...(map.get(year) ?? []), shortName(project.data.title)]);
	}
	return [...map.entries()].sort((a, b) => {
		if (a[0] === '待补充') return 1;
		if (b[0] === '待补充') return -1;
		return b[0].localeCompare(a[0]);
	});
})();
const activeYears = yearRows.map(([year]) => year).filter((year) => year !== '待补充');
const yearSpan = activeYears.length > 0 ? `${activeYears.at(-1)} — ${activeYears[0]}` : '年份待补充';

const timeline = [
	...RESUME.experience.map((item) => ({
		kind: '车队',
		period: item.period.zh,
		role: item.title.zh,
		org: item.org.zh,
		note: item.bullets[0]?.zh ?? '',
	})),
	...RESUME.education.map((item) => ({
		kind: '教育',
		period: item.period.zh,
		role: item.title.zh,
		org: item.org.zh,
		note: item.bullets[0]?.zh ?? '',
	})),
];

const tagCounts = new Map<string, number>();
allProjects.forEach((project) => project.data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)));
const rankedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'));
const SKILL_LIMIT = 18;
const skillTags = rankedTags.slice(0, SKILL_LIMIT);
const moreTagCount = Math.max(0, rankedTags.length - skillTags.length);

const email = RESUME.contact.email;
const sourceOf = (project: (typeof works)[number]['project']) =>
	project.data.repoUrl ??
	(project.data.repoPath
		? `https://github.com/zhangjszs/HUAT-kerwin-labwork/tree/main/${project.data.repoPath}`
		: undefined);
---

<BaseLayout
	title={`${SITE_NAME} | ${SITE_ROLE}`}
	description={`${SITE_ROLE}。作品集、履历、技能与联系方式。`}
	sections={sections}
>
	<div class="page" data-pagefind-body>
		<!-- ============ 首屏：擅长什么 + 简介与状态 ============ -->
		<section class="masthead" id="intro">
			<div class="mast-main">
				<p class="num-label">作品集 / {yearSpan}</p>
				<h1 class="mast-title">
					<span class="mast-line">把激光雷达点云</span>
					<span class="mast-line">变成能跑通的路径</span>
				</h1>
				<p class="mast-deck">
					我在 FSAC 车队负责感知与规划方向的开发：点云地面分割与锥桶检测、基于代价地图的路径规划，
					以及从仿真到实车的闭环验证。课堂之外，把这些能力落在 C++、Qt、Java 与机器学习的一个个可运行工程上。
				</p>
				<p class="mast-fields">
					<span>ROS 2</span><span>LiDAR 感知</span><span>路径规划</span><span>C++ / Python</span>
				</p>
				<div class="mast-actions">
					<a class="btn btn-primary" href="#works">看精选作品</a>
					<a class="btn" href={withBase('/projects/')}>全部作品</a>
					<a class="btn" href={withBase('/resume/')}>简历</a>
				</div>
			</div>

			<div class="mast-side">
				<div class="side-block">
					<h2 class="side-label">简介</h2>
					<p class="side-text">{RESUME.summary.zh}</p>
				</div>
				<div class="side-block">
					<h2 class="side-label">当前状态</h2>
					<dl class="side-facts">
						<dt>身份</dt>
						<dd>{RESUME.experience[0]?.title.zh ?? '待补充'} · {RESUME.experience[0]?.org.zh ?? '待补充'}</dd>
						<dt>在校</dt>
						<dd>{RESUME.education[0]?.org.zh ?? '待补充'} · {RESUME.education[0]?.title.zh ?? '待补充'}</dd>
						<dt>时间</dt>
						<dd>{RESUME.education[0]?.period.zh ?? '待补充'}</dd>
						<dt>开放</dt>
						<dd>实习 / 项目合作</dd>
						<dt>邮箱</dt>
						<dd><a href={`mailto:${email}`}>{email}</a></dd>
					</dl>
				</div>
				<p class="side-note">以上信息取自站内简历数据；未填写的渠道在下方「联系」区块标注为待补充。</p>
			</div>
		</section>

		<!-- ============ 左：精选作品 / 右：履历 · 技能 · 联系 ============ -->
		<div class="works-shell">
			<section class="works-main" id="works">
				<header class="sec-head">
					<span class="num-label">01 / 作品</span>
					<h2 class="sec-title">精选作品</h2>
					<p class="sec-note">点任意一张卡片，展开它的背景、职责、方案与成果。</p>
				</header>

				<div class="work-grid">
					{
						works.map(({ project, index, Body }) => (
							<>
								<ProjectCard project={project} index={index} mode="expand" />
								<dialog
									class="work-panel"
									id={`work-panel-${project.id}`}
									aria-labelledby={`work-title-${project.id}`}
									data-pagefind-ignore
								>
									<div class="panel-head">
										<p class="panel-kicker">
											<span class="panel-num">{String(index).padStart(2, '0')}</span>
											<span>{project.data.category === 'personal' ? '个人项目' : '课程实验'}</span>
											<span aria-hidden="true">/</span>
											<span>{project.data.date ?? '待补充'}</span>
										</p>
										<h2 class="panel-title">{project.data.title}</h2>
										<p class="panel-desc">{project.data.description}</p>
										<dl class="panel-facts">
											<div class="panel-fact">
												<dt>职责</dt>
												<dd>{project.data.role ?? '待补充'}</dd>
											</div>
											<div class="panel-fact">
												<dt>技术栈</dt>
												<dd>{project.data.techStack.join(' · ')}</dd>
											</div>
											{sourceOf(project) && (
												<div class="panel-fact">
													<dt>源码</dt>
													<dd>
														<a href={sourceOf(project)} target="_blank" rel="noopener noreferrer">
															查看仓库
														</a>
													</dd>
												</div>
											)}
										</dl>
										<form method="dialog" class="panel-close-form">
											<button type="submit" class="panel-close" value="close">
												关闭
												<span aria-hidden="true">✕</span>
											</button>
										</form>
									</div>
									<div class="panel-scroll" data-lenis-prevent>
										<div class="panel-body app-prose">
											<Body />
										</div>
									</div>
									<footer class="panel-foot">
										<a class="link-arrow" href={withBase(`/projects/${project.id}`)}>
											阅读完整项目页
											<span aria-hidden="true">→</span>
										</a>
										<form method="dialog">
											<button type="submit" class="btn" value="close">
												关闭
											</button>
										</form>
									</footer>
								</dialog>
							</>
						))
					}
				</div>

				<p class="works-foot">
					共 {allProjects.length} 个作品，其中 {orderedProjects.filter((p) => p.data.category === 'personal').length} 个个人项目。
					<a class="link-arrow" href={withBase('/projects/')}>
						全部作品与标签筛选 <span aria-hidden="true">→</span>
					</a>
				</p>
			</section>

			<aside class="works-rail">
				<section class="rail-block" id="timeline">
					<span class="num-label">02 / 履历</span>
					<h2 class="rail-title">在做的事</h2>
					<ul class="tl">
						{
							timeline.map((item) => (
								<li class="tl-item">
									<p class="tl-period">
										<span class="tl-kind">{item.kind}</span>
										{item.period}
									</p>
									<h3 class="tl-role">{item.role}</h3>
									<p class="tl-org">{item.org}</p>
									{item.note && <p class="tl-note">{item.note}</p>}
								</li>
							))
						}
					</ul>
					<h3 class="rail-sub">作品年表</h3>
					<ul class="years">
						{
							yearRows.map(([year, titles]) => (
								<li class="year-row">
									<span class="year-num">{year}</span>
									<span class="year-list">{titles.join(' · ')}</span>
								</li>
							))
						}
					</ul>
				</section>

				<section class="rail-block" id="skills">
					<span class="num-label">03 / 技能</span>
					<h2 class="rail-title">用到的东西</h2>
					<p class="rail-note">
						标签来自站内 {allProjects.length} 个作品的技术栈与分类；点进去是该项目标签下的真实筛选结果。
					</p>
					<ul class="chips">
						{
							skillTags.map(([tag, count]) => (
								<li>
									<a class="chip" href={`${withBase('/projects/')}?tag=${encodeURIComponent(tag)}`}>
										{tag}
										<span class="chip-count">{count}</span>
									</a>
								</li>
							))
						}
					</ul>
					{
						moreTagCount > 0 && (
							<p class="rail-more">
								另有 {moreTagCount} 个标签，见
								<a href={withBase('/projects/')}>全部作品</a>
							</p>
						)
					}
				</section>

				<section class="rail-block" id="contact">
					<span class="num-label">04 / 联系</span>
					<h2 class="rail-title">联系我</h2>
					<p class="rail-note">项目合作、实习机会、技术讨论都可以直接写信。</p>
					<ul class="contact-list">
						{
							CONTACT.map((channel) => (
								<li class="contact-row">
									<span class="contact-k">{channel.label}</span>
									{channel.href ? (
										<a
											class="contact-v"
											href={channel.href}
											target={channel.href.startsWith('http') ? '_blank' : undefined}
											rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}
										>
											{channel.value}
										</a>
									) : (
										<span class="contact-v is-todo">{channel.value}</span>
									)}
								</li>
							))
						}
					</ul>
					<a class="btn btn-primary" href={`mailto:${email}`}>写一封邮件</a>
				</section>
			</aside>
		</div>
	</div>

	<script>
		import { initMotion } from '../scripts/motion/core';

		const { lenis } = initMotion();

		const panels = Array.from(document.querySelectorAll<HTMLDialogElement>('dialog.work-panel'));

		// 卡片仍是指向详情页的链接：有 JS 时改为展开面板，无 JS 时正常跳转
		document.querySelectorAll<HTMLAnchorElement>('a[data-work-open]').forEach((trigger) => {
			trigger.addEventListener('click', (event) => {
				if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
				const panel = panels.find((item) => item.id === trigger.dataset.workOpen);
				if (!panel) return;
				event.preventDefault();
				panel.showModal();
				lenis?.stop();
			});
		});

		panels.forEach((panel) => {
			// 点遮罩（面板自身留白处）关闭
			panel.addEventListener('click', (event) => {
				if (event.target === panel) panel.close();
			});
			panel.addEventListener('close', () => {
				lenis?.start();
			});
		});
	</script>

	<style>
		.page {
			width: 100%;
			max-width: var(--max-width-app);
			margin-inline: auto;
			padding-inline: clamp(1.25rem, 5vw, 3.5rem);
			padding-bottom: clamp(4rem, 10vw, 7rem);
		}

		/* ============ 首屏 ============ */
		.masthead {
			display: grid;
			gap: clamp(2.5rem, 6vw, 4.5rem);
			grid-template-columns: minmax(0, 1fr);
			padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(3rem, 8vw, 6rem);
			border-bottom: 1px solid var(--border);
		}

		.mast-main {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
		}

		.mast-title {
			margin: 0;
			font-size: clamp(2.1rem, 5.6vw, 4.5rem);
			line-height: 1.12;
			letter-spacing: -0.015em;
		}

		.mast-line {
			display: block;
		}

		.mast-deck {
			margin: 0;
			max-width: 54ch;
			font-size: var(--text-md);
			line-height: 1.85;
			color: var(--muted-foreground);
		}

		.mast-fields {
			display: flex;
			flex-wrap: wrap;
			gap: 0.35rem 1.1rem;
			margin: 0;
			padding: 0;
			list-style: none;
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			letter-spacing: 0.04em;
			color: var(--foreground);
		}

		.mast-fields span + span::before {
			content: '/';
			margin-right: 0.9rem;
			color: var(--border-strong);
		}

		.mast-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-top: 0.5rem;
		}

		.mast-side {
			display: flex;
			flex-direction: column;
			gap: 0;
			border-top: 1px solid var(--border);
		}

		.side-block {
			display: flex;
			flex-direction: column;
			gap: 0.85rem;
			padding-block: 1.5rem;
			border-bottom: 1px solid var(--border);
		}

		.side-label {
			margin: 0;
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			font-weight: 500;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--accent);
		}

		.side-text {
			margin: 0;
			font-size: var(--text-base);
			line-height: 1.85;
			color: var(--foreground);
		}

		.side-facts {
			display: grid;
			grid-template-columns: 4.5em minmax(0, 1fr);
			gap: 0.55rem 1rem;
			margin: 0;
			font-size: var(--text-sm);
			line-height: 1.6;
		}

		.side-facts dt {
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			letter-spacing: 0.06em;
			color: var(--muted-foreground);
			padding-top: 0.15em;
		}

		.side-facts dd {
			margin: 0;
			color: var(--foreground);
		}

		.side-note {
			margin: 0;
			padding-top: 1rem;
			font-size: var(--text-xs);
			line-height: 1.7;
			color: var(--muted-foreground);
		}

		/* ============ 作品 + 右栏 ============ */
		.works-shell {
			display: grid;
			gap: clamp(3rem, 8vw, 5rem);
			grid-template-columns: minmax(0, 1fr);
			padding-top: clamp(3rem, 8vw, 5.5rem);
		}

		.sec-head {
			display: flex;
			flex-direction: column;
			gap: 0.9rem;
			margin-bottom: 2.25rem;
		}

		.sec-title,
		.rail-title {
			margin: 0;
			font-size: clamp(1.9rem, 4.5vw, 2.9rem);
			line-height: 1.15;
		}

		.sec-note,
		.rail-note {
			margin: 0;
			font-size: var(--text-sm);
			line-height: 1.75;
			color: var(--muted-foreground);
			max-width: 52ch;
		}

		.work-grid {
			display: grid;
			gap: 1.5rem;
			grid-template-columns: minmax(0, 1fr);
			align-items: start;
		}

		.works-foot {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0.5rem 1.25rem;
			margin: 2.25rem 0 0;
			padding-top: 1.25rem;
			border-top: 1px solid var(--border);
			font-size: var(--text-sm);
			color: var(--muted-foreground);
		}

		/* ============ 右栏 ============ */
		.works-rail {
			display: flex;
			flex-direction: column;
			gap: clamp(2.5rem, 6vw, 3.5rem);
		}

		.rail-block {
			display: flex;
			flex-direction: column;
			gap: 1rem;
			padding-top: 1.25rem;
			border-top: 1px solid var(--border);
		}

		.rail-block:first-child {
			border-top: 0;
			padding-top: 0;
		}

		.tl {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.tl-item {
			display: flex;
			flex-direction: column;
			gap: 0.2rem;
			padding-left: 1.1rem;
			border-left: 1px solid var(--border);
		}

		.tl-period {
			display: flex;
			flex-wrap: wrap;
			gap: 0.6rem;
			align-items: baseline;
			margin: 0;
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			letter-spacing: 0.04em;
			color: var(--muted-foreground);
		}

		.tl-kind {
			color: var(--accent);
		}

		.tl-role {
			margin: 0;
			font-size: var(--text-lg);
			line-height: 1.35;
		}

		.tl-org {
			margin: 0;
			font-size: var(--text-sm);
			color: var(--muted-foreground);
		}

		.tl-note {
			margin: 0.35rem 0 0;
			font-size: var(--text-sm);
			line-height: 1.7;
			color: var(--muted-foreground);
		}

		.rail-sub {
			margin: 1.5rem 0 0;
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			font-weight: 500;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--accent);
		}

		.years {
			display: flex;
			flex-direction: column;
			margin: 0;
			padding: 0;
			list-style: none;
			border-top: 1px solid var(--border);
		}

		.year-row {
			display: grid;
			grid-template-columns: 4em minmax(0, 1fr);
			gap: 0.75rem;
			padding-block: 0.6rem;
			border-bottom: 1px solid var(--border);
			font-size: var(--text-sm);
		}

		.year-num {
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			color: var(--accent);
			padding-top: 0.2em;
		}

		.year-list {
			color: var(--muted-foreground);
			line-height: 1.6;
		}

		.chips {
			display: flex;
			flex-wrap: wrap;
			gap: 0.45rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.chip {
			display: inline-flex;
			align-items: baseline;
			gap: 0.4rem;
			padding: 0.3rem 0.6rem;
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-sm);
			color: var(--foreground);
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			text-decoration: none;
			transition:
				border-color 0.2s var(--ease-out),
				color 0.2s var(--ease-out);
		}

		.chip:hover,
		.chip:focus-visible {
			border-color: var(--accent);
			color: var(--accent);
		}

		.chip-count {
			color: var(--muted-foreground);
			font-size: 0.9em;
		}

		.rail-more {
			margin: 0;
			font-size: var(--text-sm);
			color: var(--muted-foreground);
		}

		.contact-list {
			display: flex;
			flex-direction: column;
			margin: 0;
			padding: 0;
			list-style: none;
			border-top: 1px solid var(--border);
		}

		.contact-row {
			display: grid;
			grid-template-columns: 5.5em minmax(0, 1fr);
			gap: 0.75rem;
			align-items: baseline;
			padding-block: 0.65rem;
			border-bottom: 1px solid var(--border);
			font-size: var(--text-sm);
		}

		.contact-k {
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			letter-spacing: 0.06em;
			color: var(--muted-foreground);
		}

		.contact-v {
			color: var(--foreground);
			text-decoration: none;
			overflow-wrap: anywhere;
		}

		a.contact-v {
			text-decoration: underline;
			text-decoration-color: var(--border-strong);
			text-underline-offset: 3px;
		}

		a.contact-v:hover {
			color: var(--accent);
			text-decoration-color: var(--accent);
		}

		.contact-v.is-todo {
			color: var(--muted-foreground);
			font-style: italic;
		}

		.contact-list + .btn {
			margin-top: 0.5rem;
			align-self: flex-start;
		}

		/* ============ 展开面板 ============ */
		.work-panel {
			width: min(54rem, calc(100vw - 2rem));
			max-height: min(86svh, 56rem);
			padding: 0;
			display: none;
			flex-direction: column;
			background: var(--gray-999);
			color: var(--foreground);
			border: 1px solid var(--border-strong);
			border-radius: 0;
			box-shadow: var(--shadow-lg);
		}

		.work-panel[open] {
			display: flex;
		}

		.work-panel::backdrop {
			background: rgba(26, 26, 24, 0.5);
		}

		.panel-head {
			position: relative;
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.25rem, 4vw, 2.5rem) 1.5rem;
			border-bottom: 1px solid var(--border);
		}

		.panel-kicker {
			display: flex;
			flex-wrap: wrap;
			gap: 0.6rem;
			align-items: baseline;
			margin: 0;
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			letter-spacing: 0.06em;
			color: var(--muted-foreground);
		}

		.panel-num {
			color: var(--accent);
		}

		.panel-title {
			margin: 0;
			padding-right: 5rem;
			font-size: clamp(1.5rem, 3.4vw, 2.125rem);
			line-height: 1.25;
		}

		.panel-desc {
			margin: 0;
			max-width: 62ch;
			font-size: var(--text-base);
			line-height: 1.8;
			color: var(--muted-foreground);
		}

		.panel-facts {
			display: grid;
			gap: 0.5rem 1.5rem;
			margin: 0.35rem 0 0;
		}

		.panel-fact {
			display: grid;
			grid-template-columns: 5.5em minmax(0, 1fr);
			gap: 0.75rem;
			align-items: baseline;
			font-size: var(--text-sm);
		}

		.panel-fact dt {
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			letter-spacing: 0.06em;
			color: var(--muted-foreground);
		}

		.panel-fact dd {
			margin: 0;
		}

		.panel-close-form {
			position: absolute;
			top: clamp(1rem, 3vw, 1.75rem);
			right: clamp(1rem, 3vw, 1.75rem);
		}

		.panel-close {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.35rem 0.7rem;
			background: transparent;
			border: 1px solid var(--border);
			border-radius: 0;
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			letter-spacing: 0.06em;
			color: var(--muted-foreground);
			cursor: pointer;
			transition:
				color 0.2s var(--ease-out),
				border-color 0.2s var(--ease-out);
		}

		.panel-close:hover {
			color: var(--accent);
			border-color: var(--accent);
		}

		.panel-scroll {
			flex: 1;
			min-height: 0;
			overflow-y: auto;
			overscroll-behavior: contain;
			padding: clamp(1.25rem, 4vw, 2.5rem);
		}

		.panel-body {
			max-width: 46rem;
			margin: 0;
			font-size: var(--text-base);
		}

		.panel-foot {
			display: flex;
			flex-wrap: wrap;
			gap: 1rem;
			align-items: center;
			justify-content: space-between;
			padding: 1.1rem clamp(1.25rem, 4vw, 2.5rem);
			border-top: 1px solid var(--border);
		}

		/* ============ 断点 ============ */
		@media (min-width: 44em) {
			.work-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		@media (min-width: 50em) {
			.masthead {
				grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
				align-items: start;
			}
		}

		@media (min-width: 68em) {
			.works-shell {
				grid-template-columns: minmax(0, 1fr) 20rem;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.work-panel {
				scroll-behavior: auto;
			}
		}
	</style>
</BaseLayout>
