---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Grid from '../components/Grid.astro';
import Icon from '../components/Icon.astro';
import PointCloudHero from '../components/hero/PointCloudHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { withBase } from '../utils/paths';

const allProjects = await getCollection('projects');
// 个人项目排在前面，课程实验（labwork）靠后
const sortedProjects = allProjects.sort((a, b) => {
	if (a.data.category !== b.data.category) return a.data.category === 'personal' ? -1 : 1;
	return 0;
});
const featuredProjects = sortedProjects.filter((p) => p.data.featured).slice(0, 3);
const showcaseProjects =
	featuredProjects.length > 0
		? featuredProjects
		: sortedProjects
				.slice()
				.sort((a, b) => new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime())
				.slice(0, 3);

// 最新博客文章（首页展示前 3 篇）
const latestPosts = (await getCollection('blog'))
	.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
	.slice(0, 3);

const allTech = [...new Set(allProjects.flatMap((p) => p.data.techStack))].sort();
const stack = allTech.length > 0 ? allTech : ['ROS 2', 'LiDAR', 'Python', 'C++'];

const EMAIL = 'zhangjszs@foxmail.com';
const GITHUB = 'https://github.com/zhangjszs';
---

<BaseLayout title="Kerwin Zhang | 个人主页" description="自动驾驶工程学生 · 项目作品、技术笔记与联系方式。">
	<!-- ===== Hero：真实点云签名交互 ===== -->
	<section class="hero">
		<PointCloudHero />
		<div class="wrapper hero-overlay">
			<p class="hero-status">
				<span class="status-prompt">~/fsac $</span> ros2 topic echo /points
			</p>
			<h1 class="hero-title">Kerwin Zhang</h1>
			<p class="hero-tagline">
				湖北汽车工业学院 · <strong>FSAC 车队</strong>成员<br />
				专注 <strong>ROS 2</strong>、<strong>激光雷达感知</strong>与<strong>路径规划</strong>
			</p>
			<div class="hero-actions">
				<a href={withBase('/projects/')} class="btn btn-primary">查看项目 <Icon icon="arrow-right" size="1em" /></a>
				<a href={`mailto:${EMAIL}`} class="btn btn-ghost">联系我</a>
			</div>
		</div>
		<div class="hero-scroll-cue" aria-hidden="true">
			<span></span>
		</div>
	</section>

	<main class="wrapper narrative" data-pagefind-body>
		<!-- ===== 02 自介 ===== -->
		<section class="panel" data-reveal>
			<div class="panel-grid">
				<div class="panel-copy">
					<span class="eyebrow">01 · 关于</span>
					<h2 class="panel-title">把车交给算法，<br />把算法交给可验证的数据</h2>
					<p class="panel-desc">
						我在 FSAC
						车队负责感知与规划方向的开发：从激光雷达点云的预处理与目标检测，到基于代价地图的路径规划，再到整车在仿真与实车上的闭环验证。这里记录我做过的每一个项目、踩过的每一个坑。
					</p>
					<a href={withBase('/about/')} class="panel-link">
						了解更多 <Icon icon="arrow-right" size="0.9em" />
					</a>
				</div>
				<ul class="facts">
					<li><span class="fact-k">方向</span><span class="fact-v">ROS 2 / LiDAR / 路径规划</span></li>
					<li><span class="fact-k">车队</span><span class="fact-v">FSAC · 中国大学生方程式</span></li>
					<li><span class="fact-k">学校</span><span class="fact-v">湖北汽车工业学院</span></li>
					<li><span class="fact-k">状态</span><span class="fact-v">开放实习 / 项目合作</span></li>
				</ul>
			</div>
		</section>

		<!-- ===== 03 精选项目 ===== -->
		{
			showcaseProjects.length > 0 && (
				<section class="panel" data-reveal>
					<span class="eyebrow">02 · 项目</span>
					<h2 class="panel-title">精选作品</h2>
					<p class="panel-desc">每一个项目都带完整的技术细节与复盘。</p>
					<div class="gallery">
						<Grid variant="offset">
							{showcaseProjects.map((project) => (
								<li>
									<ProjectCard project={project} />
								</li>
							))}
						</Grid>
					</div>
					<div class="panel-cta">
						<a href={withBase('/projects/')} class="btn btn-ghost">
							全部项目 <Icon icon="arrow-right" size="1em" />
						</a>
					</div>
				</section>
			)
		}

		<!-- ===== 04 技术栈 ===== -->
		<section class="panel" data-reveal>
			<span class="eyebrow">03 · 技术栈</span>
			<h2 class="panel-title">工具箱</h2>
			<div class="stack-cloud">
				{stack.map((tech) => <span class="stack-chip">{tech}</span>)}
			</div>
		</section>

		<!-- ===== 05 最新博客 ===== -->
		{
			latestPosts.length > 0 && (
				<section class="panel" data-reveal>
					<span class="eyebrow">04 · 写作</span>
					<h2 class="panel-title">最新文章</h2>
					<p class="panel-desc">项目实践中的思考与总结。</p>
					<div class="posts">
						{latestPosts.map((post) => (
							<article class="post-row">
								<div class="post-row-main">
									<h3 class="post-row-title">
										<a href={withBase(`/blog/${post.id}`)}>{post.data.title}</a>
									</h3>
									<p class="post-row-desc">{post.data.description}</p>
								</div>
								<div class="post-row-meta">
									<time datetime={post.data.date}>{post.data.date}</time>
								</div>
							</article>
						))}
					</div>
					<div class="panel-cta">
						<a href={withBase('/blog/')} class="btn btn-ghost">
							全部文章 <Icon icon="arrow-right" size="1em" />
						</a>
					</div>
				</section>
			)
		}

		<!-- ===== 06 联系 ===== -->
		<section class="panel contact" data-reveal>
			<span class="eyebrow">05 · 联系</span>
			<h2 class="contact-title">有项目想法或机会？<br />来聊聊。</h2>
			<div class="contact-actions">
				<a href={`mailto:${EMAIL}`} class="btn btn-primary btn-lg">
					<Icon icon="envelope" size="1.1em" />
					{EMAIL}
				</a>
				<a href={GITHUB} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-lg">
					<Icon icon="github-logo" size="1.1em" /> GitHub
				</a>
				<a href={withBase('/resume/')} class="btn btn-ghost btn-lg">简历</a>
			</div>
		</section>
	</main>

	<script>
		import { initMotion, prefersReducedMotion, isMobileTier } from '../scripts/motion/core';
		import { gsap } from 'gsap';

		initMotion();

		// Hero 入场时间线（不走滚动触发）
		if (!prefersReducedMotion()) {
			const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
			tl.from('.hero-status', { opacity: 0, y: 16, duration: 0.6 }, 0.1)
				.from('.hero-title', { opacity: 0, y: 24, duration: 0.8 }, 0.25)
				.from('.hero-tagline', { opacity: 0, y: 18, duration: 0.7 }, 0.45)
				.from('.hero-actions', { opacity: 0, y: 14, duration: 0.6 }, 0.65);

			// 桌面端：滚出 hero 时内容视差上移 + 淡出（移动端禁用保性能）
			if (!isMobileTier()) {
				import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
					gsap.registerPlugin(ScrollTrigger);
					gsap.to('.hero-overlay', {
						yPercent: -18,
						opacity: 0.15,
						ease: 'none',
						scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
					});
				});
			}
		}
	</script>

	<style>
		/* ===== Hero ===== */
		.hero {
			position: relative;
			min-height: 100svh;
			display: flex;
			align-items: center;
			overflow: hidden;
		}

		.hero-overlay {
			position: relative;
			z-index: 1;
			width: 100%;
			padding-top: 5rem;
			/* 让拖拽事件穿透到 canvas，仅交互元素响应点击 */
			pointer-events: none;
		}

		.hero-overlay a {
			pointer-events: auto;
		}

		.hero-status {
			display: inline-block;
			margin: 0 0 1.5rem;
			padding: 0.4rem 0.9rem;
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			color: var(--muted-foreground);
			background: color-mix(in srgb, var(--surface) 55%, transparent);
			border: 1px solid var(--border);
			border-radius: var(--radius-full);
			backdrop-filter: blur(8px);
			-webkit-backdrop-filter: blur(8px);
		}

		.status-prompt {
			color: var(--accent);
		}

		.hero-title {
			font-size: clamp(2.75rem, 8vw, 5.5rem);
			font-weight: 700;
			letter-spacing: -0.03em;
			line-height: 1.05;
			margin: 0 0 1.25rem;
		}

		.hero-tagline {
			font-size: var(--text-md);
			color: var(--muted-foreground);
			line-height: 1.9;
			margin: 0 0 2.25rem;
		}

		.hero-tagline strong {
			color: var(--foreground);
			font-weight: 600;
		}

		.hero-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.9rem;
		}

		.hero-scroll-cue {
			position: absolute;
			bottom: 1.5rem;
			left: 50%;
			transform: translateX(-50%);
			width: 1px;
			height: 48px;
			background: var(--border);
			overflow: hidden;
			z-index: 1;
		}

		.hero-scroll-cue span {
			display: block;
			width: 100%;
			height: 16px;
			background: var(--accent);
			animation: cue-drop 2s var(--ease-out) infinite;
		}

		@keyframes cue-drop {
			0% {
				transform: translateY(-16px);
			}
			70%,
			100% {
				transform: translateY(48px);
			}
		}

		/* ===== 按钮 ===== */
		.btn {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.75rem 1.5rem;
			border-radius: var(--radius-full);
			font-weight: 600;
			font-size: var(--text-sm);
			text-decoration: none;
			transition:
				transform 0.2s var(--ease-out),
				box-shadow 0.2s var(--ease-out),
				background-color 0.2s var(--ease-out),
				border-color 0.2s var(--ease-out);
		}

		.btn-primary {
			background: var(--accent);
			color: var(--accent-foreground);
			border: 1px solid var(--accent);
			box-shadow: var(--glow-accent);
		}

		.btn-primary:hover {
			transform: translateY(-2px);
			box-shadow: 0 0 32px hsla(158, 72%, 56%, 0.3);
		}

		.btn-ghost {
			background: transparent;
			color: var(--foreground);
			border: 1px solid var(--border);
		}

		.btn-ghost:hover {
			border-color: var(--accent);
			color: var(--accent);
			transform: translateY(-2px);
		}

		.btn-lg {
			padding: 1rem 2rem;
			font-size: var(--text-base);
		}

		/* ===== 叙事区块 ===== */
		.narrative {
			display: flex;
			flex-direction: column;
			gap: clamp(5rem, 12vw, 9rem);
			padding-top: clamp(5rem, 12vw, 9rem);
			padding-bottom: clamp(5rem, 12vw, 8rem);
		}

		.panel {
			display: flex;
			flex-direction: column;
			gap: 1.25rem;
		}

		.eyebrow {
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			color: var(--accent);
			letter-spacing: 0.08em;
		}

		.panel-title {
			font-size: clamp(var(--text-2xl), 4.5vw, var(--text-4xl));
			margin: 0;
		}

		.panel-desc {
			color: var(--muted-foreground);
			font-size: var(--text-md);
			line-height: 1.8;
			max-width: 56ch;
			margin: 0;
		}

		.panel-cta {
			margin-top: 1rem;
		}

		/* 02 自介 */
		.panel-grid {
			display: grid;
			gap: 2.5rem;
			grid-template-columns: 1fr;
		}

		.panel-link {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			color: var(--accent);
			text-decoration: none;
			font-weight: 600;
			font-size: var(--text-sm);
			width: fit-content;
		}

		.panel-link:hover {
			text-decoration: underline;
			text-underline-offset: 4px;
		}

		.facts {
			list-style: none;
			margin: 0;
			padding: 1.5rem;
			display: flex;
			flex-direction: column;
			gap: 1rem;
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-lg);
			align-self: start;
		}

		.facts li {
			display: flex;
			gap: 1rem;
			align-items: baseline;
			font-size: var(--text-sm);
		}

		.fact-k {
			font-family: var(--font-mono);
			color: var(--muted-foreground);
			min-width: 3.5em;
		}

		.fact-v {
			color: var(--foreground);
		}

		/* 03 项目 */
		.gallery {
			margin-top: 1rem;
		}

		/* 04 技术栈 */
		.stack-cloud {
			display: flex;
			flex-wrap: wrap;
			gap: 0.7rem;
			max-width: 60rem;
		}

		.stack-chip {
			padding: 0.45rem 1rem;
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			color: var(--muted-foreground);
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-full);
			transition:
				color 0.2s var(--ease-out),
				border-color 0.2s var(--ease-out),
				transform 0.2s var(--ease-out);
		}

		.stack-chip:hover {
			color: var(--accent);
			border-color: var(--accent);
			transform: translateY(-2px);
		}

		/* 05 博客 */
		.posts {
			display: flex;
			flex-direction: column;
			border-top: 1px solid var(--border);
		}

		.post-row {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			padding: 1.5rem 0;
			border-bottom: 1px solid var(--border);
			transition: padding-left 0.25s var(--ease-out);
		}

		.post-row:hover {
			padding-left: 0.75rem;
		}

		.post-row-title {
			font-size: var(--text-lg);
			margin: 0;
		}

		.post-row-title a {
			color: var(--foreground);
			text-decoration: none;
		}

		.post-row-title a:hover {
			color: var(--accent);
		}

		.post-row-desc {
			margin: 0.35rem 0 0;
			color: var(--muted-foreground);
			font-size: var(--text-sm);
			line-height: 1.7;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}

		.post-row-meta {
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			color: var(--muted-foreground);
		}

		/* 06 联系 */
		.contact {
			align-items: center;
			text-align: center;
			padding: clamp(3rem, 8vw, 6rem) 0;
		}

		.contact-title {
			font-size: clamp(var(--text-2xl), 5vw, var(--text-5xl));
			line-height: 1.2;
			margin: 0 0 2rem;
		}

		.contact-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 1rem;
			justify-content: center;
		}

		@media (min-width: 50em) {
			.panel-grid {
				grid-template-columns: 1.2fr 0.8fr;
				align-items: center;
			}

			.post-row {
				flex-direction: row;
				justify-content: space-between;
				align-items: baseline;
				gap: 2rem;
			}

			.post-row-main {
				max-width: 62ch;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.hero-scroll-cue span {
				animation: none;
			}
		}
	</style>
</BaseLayout>
