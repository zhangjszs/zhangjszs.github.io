---
import LabLayout from '../layouts/LabLayout.astro';
import PerceptionScene from '../components/hero/PerceptionScene.astro';
import MissionProjects from '../components/MissionProjects.astro';
import { withBase } from '../utils/paths';
import { CONTACT, SITE_NAME } from '../data/site';
import { RESUME } from '../data/resume';
const email = CONTACT.find((channel) => channel.label === 'Email')!;
const github = CONTACT.find((channel) => channel.label === 'GitHub')!;
const capabilities = [
	{
		num: '01',
		name: 'PERCEPTION',
		title: '从点云里，看见世界。',
		text: '激光雷达点云处理、地面分割与锥桶检测。让原始传感器输入成为可理解的环境。',
		tools: 'LiDAR / RANSAC / C++',
	},
	{
		num: '02',
		name: 'PLANNING',
		title: '从可能中，找到路径。',
		text: '把环境模型连接到路径规划与控制，在仿真和实车之间建立可验证的工程链路。',
		tools: 'ROS / PATH PLANNING / PYTHON',
	},
	{
		num: '03',
		name: 'ENGINEERING',
		title: '让想法，真正运行。',
		text: '模块化系统、跨语言工具与可复现实验。从自动驾驶到轨道计算，持续把问题写成工程。',
		tools: 'C++20 / CMAKE / GIT',
	},
];
---

<LabLayout
	title={`${SITE_NAME} — 感知未知，构建可能`}
	description="Kerwin Zhang 的交互式工程作品集。探索 3D 自动驾驶实验场、LiDAR 感知、路径规划与 C++ 项目。"
>
	<header class="lab-header" data-pagefind-ignore>
		<a class="lab-brand" href={withBase('/')} aria-label={`${SITE_NAME} 首页`}
			><span class="brand-mark" aria-hidden="true">k<span>z</span>.</span><span class="brand-name"
				>KERWIN<br />ZHANG</span
			></a
		>
		<nav class="lab-nav" aria-label="主导航">
			<a href="#works"><span>01</span> 作品</a><a href="#timeline"><span>02</span> 关于</a><a href="#contact"
				><span>03</span> 联系</a
			>
		</nav>
		<a class="resume-link" href={withBase('/resume/')}><span>查看简历</span><span aria-hidden="true">↗</span></a>
	</header>
	<main id="main" data-pagefind-body>
		<section class="lab-hero" aria-labelledby="hero-title">
			<div class="hero-meta">
				<p>INDEPENDENT MIND. ENGINEERING HANDS.</p><span><i aria-hidden="true"></i> 开放实习 / 项目合作</span>
			</div>
			<div class="hero-experiment">
				<div class="hero-copy">
					<p class="hero-eyebrow"><span class="cross" aria-hidden="true">+</span> AUTONOMOUS EXPLORATIONS / 001</p>
					<h1 id="hero-title">
						<span>SEE THE</span><span class="hero-accent">UNSEEN<span class="hero-period">.</span></span><span
							class="sr-only">Kerwin Zhang · 自动驾驶、感知与规划</span
						>
					</h1>
					<div class="hero-note">
						<p class="hero-chinese">感知未知，<br />构建可能。</p><p class="hero-description">
							我是 Kerwin，在 FSAC 车队做感知与规划。<br />把点云变成环境，把算法变成能跑起来的系统。
						</p><a class="hero-cta" href="#works">探索我的作品 <span aria-hidden="true">↘</span></a>
					</div>
				</div>
				<div class="hero-scene"><PerceptionScene /></div>
				<div class="hero-side-label" aria-hidden="true">EST. 2022 / ALWAYS IN PROGRESS</div>
			</div>
			<div class="hero-footer">
				<p><span class="coordinate-cross" aria-hidden="true">⌖</span> HUAT / FSAC TEAM</p><p class="hero-scroll">
					SCROLL TO DISCOVER <span aria-hidden="true">↓</span>
				</p><p>CODE MEETS THE PHYSICAL WORLD.</p>
			</div>
		</section>
		<div class="discipline-strip" aria-label="技术方向">
			<span>PERCEPTION</span><span class="strip-star" aria-hidden="true">✳</span><span>PLANNING</span><span
				class="strip-star"
				aria-hidden="true">✳</span
			><span>CONTROL</span><span class="strip-star" aria-hidden="true">✳</span><span>EXPLORATION</span><span
				class="strip-star"
				aria-hidden="true">✳</span
			>
		</div>
		<MissionProjects />
		<section class="lab-about" id="timeline" aria-labelledby="about-title">
			<div class="section-eyebrow"><span>02 / THE PERSON IN THE LOOP</span><span>ABOUT ME</span></div>
			<div class="about-intro" data-lab-reveal>
				<h2 id="about-title">不止于屏幕。<br /><span>让代码走进现实。</span></h2><div class="about-copy">
					<p>{RESUME.summary.zh}</p><p>
						对我来说，有意思的工程总发生在边界上：软件与硬件、数学与现实、一个想法与一个真正运行的系统之间。
					</p><a href={withBase('/about/')}>更多关于我 <span aria-hidden="true">↗</span></a>
				</div>
			</div>
			<div class="capabilities" id="skills">
				{
					capabilities.map((item) => (
						<article class="capability" data-lab-reveal>
							<>
								<div class="capability-index">
									<>
										<span>{item.num}</span>
										<span aria-hidden="true">↗</span>
									</>
								</div>
								<p class="capability-name">{item.name}</p>
								<h3>{item.title}</h3>
								<p class="capability-text">{item.text}</p>
								<p class="capability-tools">{item.tools}</p>
							</>
						</article>
					))
				}
			</div>
		</section>
		<section class="lab-contact" id="contact" aria-labelledby="contact-title">
			<div class="contact-topline"><span>03 / NEXT MISSION</span><span>LET'S MAKE IT HAPPEN.</span></div><h2
				id="contact-title"
				data-lab-reveal
			>
				GOT A<br />WILD IDEA<span>?</span>
			</h2><div class="contact-bottom">
				<p>实习机会、项目合作，<br />或者一个值得折腾的技术问题。</p><a class="contact-email" href={email.href}
					>{email.value}<span aria-hidden="true">↗</span></a
				>
			</div>
		</section>
	</main>
	<footer class="lab-footer" data-pagefind-ignore>
		<a class="footer-signature" href={withBase('/')} aria-label="返回首页">KZ<span>↗</span></a><div
			class="footer-links"
		>
			<a href={github.href} target="_blank" rel="noopener noreferrer">GITHUB ↗</a><a href={withBase('/blog/')}>笔记</a
			><a href={withBase('/resume/')}>简历</a><a href={withBase('/rss.xml')}>RSS</a>
		</div><p>© {new Date().getFullYear()} KERWIN ZHANG<br /><span>BUILT WITH ASTRO + THREE.JS</span></p><a
			href="#main"
			class="back-top"
			aria-label="返回顶部">↑</a
		>
	</footer>
	<script>
		import '../scripts/lab-home';
	</script>
</LabLayout>
<style>
	.lab-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		margin: 0 3.2%;
		min-height: 102px;
		border-bottom: 1px solid var(--lab-line);
	}
	.lab-brand {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.brand-mark {
		color: var(--lab-accent);
		font-size: 3.2rem;
		font-weight: 850;
		letter-spacing: -0.14em;
		line-height: 1;
	}
	.brand-mark > span {
		display: inline-block;
		transform: skewY(-12deg);
	}
	.brand-name {
		font-size: 0.72rem;
		font-weight: 650;
		line-height: 1.25;
		letter-spacing: 0.08em;
	}
	.lab-nav {
		display: flex;
		gap: clamp(1.25rem, 4vw, 4rem);
	}
	.lab-nav a {
		font-size: 0.85rem;
	}
	.lab-nav a > span {
		margin-right: 0.45rem;
		font: 0.6rem var(--font-mono);
		color: var(--lab-muted);
	}
	.lab-nav a:hover,
	.footer-links a:hover {
		color: var(--lab-accent);
	}
	.resume-link {
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--lab-line);
		font-size: 0.8rem;
	}
	.resume-link:hover {
		background: var(--lab-accent);
		color: var(--lab-bg);
		border-color: var(--lab-accent);
	}
	.lab-hero {
		padding: 0 3.2%;
	}
	.hero-meta,
	.hero-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font: 0.65rem var(--font-mono);
		letter-spacing: 0.045em;
	}
	.hero-meta {
		padding-top: 1.4rem;
		color: var(--lab-muted);
	}
	.hero-meta > span {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-size: 0.7rem;
	}
	.hero-meta i {
		display: inline-block;
		height: 6px;
		width: 6px;
		border-radius: 50%;
		background: var(--lab-accent);
	}
	.hero-experiment {
		position: relative;
		min-height: 704px;
		height: min(81svh, 880px);
		isolation: isolate;
	}
	.hero-copy {
		position: relative;
		z-index: 2;
		padding-top: clamp(3.5rem, 6vw, 6rem);
		pointer-events: none;
		width: 70%;
	}
	.hero-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font: 0.62rem var(--font-mono);
		letter-spacing: 0.07em;
		margin-bottom: 1.6rem;
	}
	.cross {
		font-size: 1.4rem;
		line-height: 1;
		color: var(--lab-accent);
	}
	h1 {
		font-size: clamp(5rem, 10.8vw, 10.5rem);
		font-weight: 780;
		letter-spacing: -0.085em;
		line-height: 0.86;
		text-wrap: nowrap;
	}
	h1 > span:not(.sr-only) {
		display: block;
	}
	.hero-accent {
		color: var(--lab-accent);
	}
	.hero-period {
		letter-spacing: -0.12em;
	}
	.hero-note {
		margin-top: 2.7rem;
	}
	.hero-chinese {
		font-size: clamp(1.4rem, 2.2vw, 2.1rem);
		font-weight: 550;
		line-height: 1.4;
		letter-spacing: -0.04em;
	}
	.hero-description {
		margin-top: 1rem;
		font-size: 0.8rem;
		color: var(--lab-muted);
		line-height: 1.9;
	}
	.hero-cta {
		pointer-events: auto;
		display: inline-flex;
		align-items: center;
		gap: 2rem;
		margin-top: 1.6rem;
		padding-bottom: 0.45rem;
		font-size: 0.8rem;
		border-bottom: 1px solid var(--lab-accent);
	}
	.hero-cta > span {
		color: var(--lab-accent);
		font-size: 1.4rem;
		transition: transform 0.2s;
	}
	.hero-cta:hover > span {
		transform: translate(4px, 4px);
	}
	.hero-scene {
		position: absolute;
		z-index: 1;
		inset: 8% -1.5% 0 25%;
	}
	.hero-side-label {
		position: absolute;
		right: 0;
		top: 28%;
		writing-mode: vertical-rl;
		font: 0.58rem var(--font-mono);
		letter-spacing: 0.1em;
		color: var(--lab-muted);
		z-index: 3;
	}
	.hero-footer {
		min-height: 65px;
		border-top: 1px solid var(--lab-line);
		color: var(--lab-muted);
	}
	.coordinate-cross {
		margin-right: 0.6rem;
		color: var(--lab-accent);
	}
	.hero-scroll {
		display: flex;
		align-items: center;
		gap: 1.4rem;
	}
	.hero-scroll span {
		font-size: 1.2rem;
		color: var(--lab-text);
	}
	.discipline-strip {
		display: flex;
		align-items: center;
		justify-content: space-around;
		gap: 1rem;
		overflow: hidden;
		padding: 1.15rem 3.2%;
		background: var(--lab-accent);
		color: var(--lab-bg);
		font-size: clamp(1.2rem, 2.7vw, 2.7rem);
		font-weight: 650;
		letter-spacing: -0.04em;
		white-space: nowrap;
	}
	.strip-star {
		font-size: 1.1em;
		font-weight: 400;
	}
	.lab-about {
		padding: 7rem 3.2%;
	}
	.section-eyebrow {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--lab-line);
		font: 0.65rem var(--font-mono);
		letter-spacing: 0.07em;
	}
	.section-eyebrow > span:last-child {
		color: var(--lab-muted);
	}
	.about-intro {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 5rem;
		padding: 4rem 0 5rem;
	}
	.about-intro h2 {
		font-size: clamp(2.4rem, 4.5vw, 5rem);
		font-weight: 550;
		letter-spacing: -0.06em;
		line-height: 1.3;
	}
	.about-intro h2 > span {
		color: var(--lab-muted);
	}
	.about-copy {
		max-width: 28rem;
		padding-top: 0.6rem;
	}
	.about-copy > p {
		color: var(--lab-muted);
		font-size: 0.9rem;
		line-height: 1.9;
		margin-bottom: 1rem;
	}
	.about-copy > a {
		display: inline-flex;
		gap: 2rem;
		padding-bottom: 0.4rem;
		margin-top: 0.5rem;
		font-size: 0.8rem;
		border-bottom: 1px solid var(--lab-line);
	}
	.about-copy > a > span {
		color: var(--lab-accent);
	}
	.capabilities {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid var(--lab-line);
	}
	.capability {
		padding: 2rem 2rem 0;
		border-left: 1px solid var(--lab-line);
	}
	.capability:first-child {
		padding-left: 0;
		border-left: 0;
	}
	.capability:last-child {
		padding-right: 0;
	}
	.capability-index {
		display: flex;
		justify-content: space-between;
		font: 0.7rem var(--font-mono);
		color: var(--lab-muted);
	}
	.capability-index > span:last-child {
		color: var(--lab-accent);
	}
	.capability-name {
		font: 0.65rem var(--font-mono);
		color: var(--lab-accent);
		margin: 2.2rem 0 1rem;
		letter-spacing: 0.08em;
	}
	.capability h3 {
		font-size: 1.45rem;
		font-weight: 500;
		letter-spacing: -0.04em;
	}
	.capability-text {
		font-size: 0.83rem;
		line-height: 1.9;
		color: var(--lab-muted);
		margin-top: 1rem;
		max-width: 24rem;
	}
	.capability-tools {
		font: 0.6rem var(--font-mono);
		margin-top: 2rem;
		padding-bottom: 0.5rem;
		color: var(--lab-muted);
	}
	.lab-contact {
		background: var(--lab-accent);
		color: var(--lab-bg);
		padding: 2rem 3.2% 3rem;
	}
	.contact-topline {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font: 0.65rem var(--font-mono);
		letter-spacing: 0.05em;
	}
	.lab-contact h2 {
		color: inherit;
		font-size: clamp(5rem, 12vw, 13rem);
		line-height: 0.87;
		letter-spacing: -0.085em;
		font-weight: 750;
		padding: 4.5rem 0;
	}
	.lab-contact h2 > span {
		display: inline-block;
		transform: rotate(10deg);
	}
	.contact-bottom {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
	}
	.contact-bottom > p {
		font-size: 0.85rem;
		line-height: 1.8;
	}
	.contact-email {
		display: flex;
		align-items: center;
		gap: 3rem;
		border-bottom: 1px solid currentColor;
		padding-bottom: 0.5rem;
		font-size: clamp(1.1rem, 2.3vw, 2.5rem);
		letter-spacing: -0.04em;
	}
	.contact-email > span {
		transition: transform 0.2s;
	}
	.contact-email:hover > span {
		transform: translate(4px, -4px);
	}
	.lab-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 2rem;
		padding: 3rem 3.2%;
	}
	.footer-signature {
		font-size: 3rem;
		font-weight: 750;
		letter-spacing: -0.09em;
	}
	.footer-signature > span {
		font-size: 1rem;
		vertical-align: top;
		color: var(--lab-accent);
		padding-left: 0.2rem;
	}
	.footer-links {
		display: flex;
		gap: 2rem;
		font: 0.7rem var(--font-mono);
	}
	.lab-footer > p {
		font: 0.6rem/1.9 var(--font-mono);
	}
	.lab-footer > p > span {
		color: var(--lab-muted);
	}
	.back-top {
		padding: 0.8rem 1rem;
		border: 1px solid var(--lab-line);
		font-size: 1.25rem;
	}
	@media (min-width: 1600px) {
		.hero-experiment {
			min-height: 800px;
		}
	}
	@media (max-width: 1000px) {
		.hero-experiment {
			min-height: 720px;
		}
		.hero-scene {
			left: 20%;
			top: 15%;
		}
		.hero-copy {
			width: 85%;
		}
		.hero-description {
			max-width: 270px;
		}
		.hero-description br {
			display: none;
		}
		.about-intro {
			gap: 2rem;
		}
		.capability {
			padding-left: 1.25rem;
			padding-right: 1.25rem;
		}
		.capability h3 {
			font-size: 1.15rem;
		}
		.hero-footer > p:last-child {
			display: none;
		}
	}
	@media (max-width: 680px) {
		.lab-header {
			min-height: 80px;
			margin: 0 5%;
			gap: 1rem;
		}
		.brand-mark {
			font-size: 2.6rem;
		}
		.brand-name {
			display: none;
		}
		.lab-nav {
			gap: 1.1rem;
		}
		.lab-nav a {
			font-size: 0.75rem;
		}
		.lab-nav a > span {
			display: none;
		}
		.resume-link {
			gap: 0.7rem;
			padding: 0.55rem 0.65rem;
			font-size: 0.7rem;
		}
		.lab-hero {
			padding: 0 5%;
		}
		.hero-meta {
			padding-top: 1rem;
			font-size: 0.48rem;
		}
		.hero-meta > p {
			max-width: 145px;
		}
		.hero-meta > span {
			font-size: 0.57rem;
			white-space: nowrap;
		}
		.hero-experiment {
			height: auto;
			min-height: 0;
			padding-bottom: 0;
		}
		.hero-copy {
			width: 100%;
			padding-top: 2.5rem;
		}
		.hero-eyebrow {
			font-size: 0.48rem;
			margin-bottom: 1.25rem;
			gap: 0.5rem;
		}
		h1 {
			font-size: clamp(4.5rem, 16.5vw, 7rem);
			letter-spacing: -0.08em;
		}
		.hero-note {
			margin-top: 1.5rem;
			display: grid;
			grid-template-columns: 1fr 1.15fr;
			gap: 0.7rem 1rem;
		}
		.hero-chinese {
			font-size: 1.2rem;
		}
		.hero-description {
			margin: 0;
			font-size: 0.68rem;
			line-height: 1.8;
		}
		.hero-cta {
			justify-self: start;
			margin-top: 0.5rem;
			font-size: 0.7rem;
			gap: 1rem;
		}
		.hero-scene {
			position: relative;
			inset: auto;
			width: calc(100% + 10vw);
			margin-left: -5vw;
			height: 600px;
			margin-top: -1rem;
		}
		.hero-side-label {
			display: none;
		}
		.hero-footer {
			min-height: 56px;
			font-size: 0.48rem;
		}
		.hero-scroll {
			gap: 0.75rem;
		}
		.discipline-strip {
			padding: 1rem 5%;
			gap: 1.5rem;
			font-size: 1.2rem;
			justify-content: flex-start;
		}
		.discipline-strip > span:nth-child(n + 6) {
			display: none;
		}
		.lab-about {
			padding: 4rem 5%;
