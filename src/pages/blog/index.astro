---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import { withBase } from '../../utils/paths';

const articles = await getCollection('blog');
const sortedArticles = articles.sort((a, b) => {
	if (!a.data.date || !b.data.date) return 0;
	return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<BaseLayout title="博客 | Kerwin Zhang" description="技术随笔、项目复盘与学习笔记。">
	<div class="wrapper" data-pagefind-body>
		<PageHeader eyebrow="02 · writing" title="博客" description="项目实践中的思考、复盘与学习笔记。">
			{
				sortedArticles.length > 0 && (
					<p class="count-line">
						<strong>{sortedArticles.length}</strong> 篇文章
					</p>
				)
			}
		</PageHeader>

		<div class="posts">
			{
				sortedArticles.map((article, i) => (
					<article class="post-row" data-reveal data-reveal-delay={String(Math.min(i, 4) * 0.06)}>
						<div class="post-row-main">
							<h2 class="post-row-title">
								<a href={withBase(`/blog/${article.id}`)}>{article.data.title}</a>
							</h2>
							<p class="post-row-desc">{article.data.description}</p>
							{article.data.relatedProject && (
								<a href={withBase(`/projects/${article.data.relatedProject}`)} class="related-link">
									<Icon icon="arrow-right" size="0.85em" />
									相关项目
								</a>
							)}
						</div>
						<div class="post-row-meta">
							{article.data.date && <time datetime={article.data.date}>{article.data.date}</time>}
							<div class="post-tags">
								{article.data.tags.map((tag) => (
									<span class="post-tag">{tag}</span>
								))}
							</div>
						</div>
					</article>
				))
			}
		</div>
		<div class="page-end"></div>
	</div>

	<script>
		import { initMotion } from '../../scripts/motion/core';
		initMotion();
	</script>

	<style>
		.count-line {
			margin: 0.5rem 0 0;
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			color: var(--muted-foreground);
		}

		.count-line strong {
			color: var(--accent);
			font-weight: 600;
		}

		.posts {
			display: flex;
			flex-direction: column;
			border-top: 1px solid var(--border);
		}

		.post-row {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			padding: 2rem 0;
			border-bottom: 1px solid var(--border);
			transition: padding-left 0.25s var(--ease-out);
		}

		.post-row:hover {
			padding-left: 0.75rem;
		}

		.post-row-title {
			font-size: var(--text-xl);
			margin: 0;
			line-height: 1.3;
		}

		.post-row-title a {
			color: var(--foreground);
			text-decoration: none;
			transition: color 0.2s var(--ease-out);
		}

		.post-row-title a:hover {
			color: var(--accent);
		}

		.post-row-desc {
			margin: 0.4rem 0 0;
			color: var(--muted-foreground);
			font-size: var(--text-sm);
			line-height: 1.7;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}

		.related-link {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			margin-top: 0.6rem;
			font-size: var(--text-xs);
			font-weight: 600;
			color: var(--accent);
			text-decoration: none;
			width: fit-content;
		}

		.related-link:hover {
			text-decoration: underline;
			text-underline-offset: 3px;
		}

		.post-row-meta {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			align-items: flex-start;
			font-family: var(--font-mono);
			font-size: var(--text-xs);
			color: var(--muted-foreground);
		}

		.post-tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
		}

		.post-tag {
			padding: 0.15rem 0.55rem;
			background: color-mix(in srgb, var(--accent) 10%, transparent);
			color: var(--accent);
			border-radius: var(--radius-full);
			font-size: var(--text-xs);
		}

		.page-end {
			height: clamp(3rem, 8vw, 6rem);
		}

		@media (min-width: 50em) {
			.post-row {
				flex-direction: row;
				justify-content: space-between;
				gap: 2.5rem;
			}

			.post-row-main {
				max-width: 62ch;
			}

			.post-row-meta {
				align-items: flex-end;
				text-align: right;
				flex-shrink: 0;
			}
		}
	</style>
</BaseLayout>
