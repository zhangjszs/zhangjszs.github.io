---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodePreview from '../../components/CodePreview.astro';
import FileTree from '../../components/FileTree.astro';
import Giscus from '../../components/Giscus.astro';
import Icon from '../../components/Icon.astro';
import MermaidDiagram from '../../components/MermaidDiagram.astro';
import ScreenshotGallery from '../../components/ScreenshotGallery.astro';
import ViewCount from '../../components/ViewCount.astro';
import { withBase } from '../../utils/paths';
import { SITE_NAME } from '../../data/site';

export async function getStaticPaths() {
	const articles = await getCollection('blog');
	return articles.map((article) => ({
		params: { slug: article.id },
		props: { article },
	}));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, date, tags, relatedProject } = article.data;

const publishedTime = date ? new Date(date).toISOString() : new Date().toISOString();
---

<BaseLayout title={`${title} · ${SITE_NAME}`} description={description} ogType="article" publishedTime={publishedTime}>
	<article class="article-page" data-pagefind-body>
		<header class="article-hero">
			<div class="wrapper">
				<nav class="breadcrumbs" aria-label="面包屑">
					<a href={withBase('/')}>首页</a>
					<span>/</span>
					<a href={withBase('/blog/')}>博客</a>
					<span>/</span>
					<span class="current">{title}</span>
				</nav>
				<h1>{title}</h1>
				<p class="hero-description">{description}</p>
				<div class="article-meta">
					{
						date && (
							<span class="meta-item">
								<Icon icon="calendar" size="1em" />
								<time datetime={date}>{date}</time>
							</span>
						)
					}
					{tags.map((tag) => <span class="meta-tag">{tag}</span>)}
					<ViewCount />
				</div>
			</div>
		</header>

		<div class="wrapper content-wrapper app-prose" data-reveal>
			<Content components={{ MermaidDiagram, ScreenshotGallery, CodePreview, FileTree }} />
		</div>

		<div class="wrapper">
			<Giscus />
		</div>

		<nav class="article-nav">
			<div class="wrapper">
				<a href={withBase('/blog/')} class="back-link">
					<Icon icon="arrow-left" size="1.1em" />
					返回全部文章
				</a>
				{
					relatedProject && (
						<a href={withBase(`/projects/${relatedProject}`)} class="related-link">
							查看相关项目
							<Icon icon="arrow-right" size="1.1em" />
						</a>
					)
				}
			</div>
		</nav>
	</article>

	<script>
		import { initMotion } from '../../scripts/motion/core';
		initMotion();
	</script>

	<style>
		.article-hero {
			padding: clamp(3.5rem, 8vw, 5.5rem) 0 clamp(2.5rem, 5vw, 3.5rem);
			border-bottom: 1px solid var(--border);
			margin-bottom: clamp(2.5rem, 6vw, 4rem);
		}

		.article-hero .wrapper {
			max-width: 75ch;
		}

		.breadcrumbs {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			align-items: center;
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			color: var(--muted-foreground);
			margin-bottom: 1.75rem;
		}

		.breadcrumbs a {
			color: var(--accent);
			text-decoration: none;
		}

		.breadcrumbs a:hover {
			text-decoration: underline;
			text-underline-offset: 3px;
		}

		.breadcrumbs .current {
			color: var(--muted-foreground);
		}

		.article-hero h1 {
			font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
			letter-spacing: -0.03em;
			margin: 0 0 1rem;
			line-height: 1.2;
		}

		.hero-description {
			font-size: var(--text-md);
			color: var(--muted-foreground);
			line-height: 1.8;
			margin: 0 0 1.5rem;
		}

		.article-meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			align-items: center;
		}

		.meta-item {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			color: var(--muted-foreground);
		}

		.meta-tag {
			padding: 0.25rem 0.7rem;
			background: color-mix(in srgb, var(--accent) 12%, transparent);
			color: var(--accent);
			border-radius: var(--radius-full);
			font-size: var(--text-xs);
			font-weight: 500;
		}

		.content-wrapper {
			padding-bottom: clamp(3rem, 8vw, 5rem);
		}

		.article-nav {
			padding: 2.5rem 0 4rem;
			border-top: 1px solid var(--border);
		}

		.article-nav .wrapper {
			display: flex;
			justify-content: space-between;
			align-items: center;
			flex-wrap: wrap;
			gap: 1rem;
		}

		.back-link,
		.related-link {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.7rem 1.4rem;
			text-decoration: none;
			font-weight: 600;
			font-size: var(--text-sm);
			border-radius: var(--radius-full);
			transition:
				border-color 0.2s var(--ease-out),
				color 0.2s var(--ease-out),
				background-color 0.2s var(--ease-out),
				transform 0.2s var(--ease-out);
		}

		.back-link {
			background: var(--surface);
			color: var(--foreground);
			border: 1px solid var(--border);
		}

		.back-link:hover {
			border-color: var(--accent);
			color: var(--accent);
			transform: translateX(-4px);
		}

		.related-link {
			background: var(--accent);
			color: var(--accent-foreground);
			border: 1px solid var(--accent);
			box-shadow: var(--glow-accent);
		}

		.related-link:hover {
			transform: translateX(4px);
			box-shadow: 0 0 32px hsla(158, 72%, 56%, 0.3);
		}
	</style>
</BaseLayout>
