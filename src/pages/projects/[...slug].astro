---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodePreview from '../../components/CodePreview.astro';
import FileTree from '../../components/FileTree.astro';
import Giscus from '../../components/Giscus.astro';
import Icon from '../../components/Icon.astro';
import MermaidDiagram from '../../components/MermaidDiagram.astro';
import ScreenshotGallery from '../../components/ScreenshotGallery.astro';
import ViewCount from '../../components/ViewCount.astro';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const {
	title,
	description,
	repoUrl,
	repoPath,
	tags,
	keywords,
	techStack,
	demoUrl,
	externalDeployUrl,
	date,
	difficulty,
	status,
	architecture,
	challenges,
	lessons,
} = project.data;

// 源码链接：个人项目直接使用 repoUrl；课程实验回退到 HUAT-kerwin-labwork 仓库子目录
// TODO: 如课程实验仓库地址有变，请修改下面的回退地址
const sourceUrl =
	repoUrl ?? (repoPath ? `https://github.com/kerwin-lab/HUAT-kerwin-labwork/tree/main/${repoPath}` : undefined);

const STATUS_LABEL: Record<string, string> = {
	completed: '已完成',
	'in progress': '进行中',
	archived: '已归档',
};
---

<BaseLayout title={`${title} | 项目`} description={description}>
	<article class="project-article" data-pagefind-body>
		<header class="detail-hero">
			<div class="wrapper">
				<nav class="breadcrumbs" aria-label="面包屑">
					<a href={withBase('/')}>首页</a>
					<span>/</span>
					<a href={withBase('/projects/')}>项目</a>
					<span>/</span>
					<span class="current">{title}</span>
				</nav>
				<h1>{title}</h1>
				<p class="hero-description">{description}</p>
				<div class="hero-meta">
					{difficulty && <span class="badge">{difficulty}</span>}
					{
						status && (
							<span class={`badge badge-${status.toLowerCase().replace(' ', '-')}`}>
								{STATUS_LABEL[status.toLowerCase()] ?? status}
							</span>
						)
					}
					{
						date && (
							<span class="meta-item">
								<Icon icon="calendar" size="1em" />
								{date}
							</span>
						)
					}
					<ViewCount />
				</div>
				<div class="hero-tech">
					{techStack.map((tech) => <span class="tech-badge">{tech}</span>)}
				</div>
				<div class="hero-actions">
					{
						sourceUrl && (
							<a class="btn btn-primary" href={sourceUrl} target="_blank" rel="noopener noreferrer">
								<Icon icon="github-logo" size="1.1em" />
								查看源码
							</a>
						)
					}
					{
						demoUrl && (
							<a class="btn btn-ghost" href={demoUrl} target="_blank" rel="noopener noreferrer">
								<Icon icon="rocket-launch" size="1.1em" />
								在线演示
							</a>
						)
					}
					{
						externalDeployUrl && (
							<a class="btn btn-ghost" href={externalDeployUrl} target="_blank" rel="noopener noreferrer">
								<Icon icon="globe" size="1.1em" />
								部署地址
							</a>
						)
					}
				</div>
			</div>
		</header>

		<!-- 概览 -->
		{
			(tags.length > 0 || (keywords?.length ?? 0) > 0 || architecture) && (
				<section class="section section-alt" data-reveal>
					<div class="wrapper">
						<span class="section-eyebrow">01 · 概览</span>
						<h2 class="section-title">项目概览</h2>
						<div class="overview-grid">
							{tags.length > 0 && (
								<div class="overview-card">
									<h3>标签</h3>
									<div class="pill-list">
										{tags.map((tag) => (
											<span class="pill">{tag}</span>
										))}
									</div>
								</div>
							)}
							{(keywords?.length ?? 0) > 0 && (
								<div class="overview-card">
									<h3>关键词</h3>
									<div class="pill-list">
										{keywords!.map((kw) => (
											<span class="pill pill-dim">{kw}</span>
										))}
									</div>
								</div>
							)}
							{architecture && (
								<div class="overview-card wide">
									<h3>架构</h3>
									<p>{architecture}</p>
								</div>
							)}
						</div>
					</div>
				</section>
			)
		}

		<!-- 正文（MDX） -->
		<section class="section" data-reveal>
			<div class="wrapper content-wrapper app-prose">
				<Content components={{ ScreenshotGallery, CodePreview, MermaidDiagram, FileTree }} />
			</div>
		</section>

		<!-- 挑战 -->
		{
			challenges && challenges.length > 0 && (
				<section class="section section-alt" data-reveal>
					<div class="wrapper">
						<span class="section-eyebrow">02 · 难点</span>
						<h2 class="section-title">挑战与解法</h2>
						<div class="challenges-list">
							{challenges.map((challenge, i) => (
								<div class="challenge-item">
									<span class="challenge-num">{String(i + 1).padStart(2, '0')}</span>
									<p>{challenge}</p>
								</div>
							))}
						</div>
					</div>
				</section>
			)
		}

		<!-- 复盘 -->
		{
			lessons && lessons.length > 0 && (
				<section class="section" data-reveal>
					<div class="wrapper">
						<span class="section-eyebrow">03 · 复盘</span>
						<h2 class="section-title">复盘要点</h2>
						<div class="lessons-list">
							{lessons.map((lesson) => (
								<div class="lesson-item">
									<Icon icon="check-circle" size="1.25em" />
									<p>{lesson}</p>
								</div>
							))}
						</div>
					</div>
				</section>
			)
		}

		<div class="wrapper">
			<Giscus />
		</div>

		<nav class="detail-nav">
			<div class="wrapper">
				<a href={withBase('/projects/')} class="back-link">
					<Icon icon="arrow-left" size="1.1em" />
					返回全部项目
				</a>
			</div>
		</nav>
	</article>

	<script>
		import { initMotion } from '../../scripts/motion/core';
		initMotion();
	</script>

	<style>
		.detail-hero {
			padding: clamp(3.5rem, 8vw, 5.5rem) 0 clamp(2.5rem, 5vw, 3.5rem);
			border-bottom: 1px solid var(--border);
		}

		.breadcrumbs {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			align-items: center;
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			color: var(--muted-foreground);
			margin-bottom: 1.75rem;
		}

		.breadcrumbs a {
			color: var(--accent);
			text-decoration: none;
		}

		.breadcrumbs a:hover {
			text-decoration: underline;
			text-underline-offset: 3px;
		}

		.breadcrumbs .current {
			color: var(--muted-foreground);
		}

		.detail-hero h1 {
			font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
			letter-spacing: -0.03em;
			margin: 0 0 1rem;
			max-width: 24ch;
			line-height: 1.15;
		}

		.hero-description {
			font-size: var(--text-md);
			color: var(--muted-foreground);
			max-width: 62ch;
			margin: 0 0 1.5rem;
			line-height: 1.8;
		}

		.hero-meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			align-items: center;
			margin-bottom: 1.25rem;
		}

		.badge {
			padding: 0.3rem 0.8rem;
			border-radius: var(--radius-full);
			font-size: var(--text-xs);
			font-weight: 600;
			background: color-mix(in srgb, var(--accent) 12%, transparent);
			color: var(--accent);
			border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
		}

		.badge-in-progress {
			background: color-mix(in srgb, var(--accent-warm) 14%, transparent);
			color: var(--accent-warm);
			border-color: color-mix(in srgb, var(--accent-warm) 30%, transparent);
		}

		.badge-archived {
			background: var(--muted);
			color: var(--muted-foreground);
			border-color: var(--border);
		}

		.meta-item {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			color: var(--muted-foreground);
		}

		.hero-tech {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			margin-bottom: 1.75rem;
		}

		.tech-badge {
			padding: 0.35rem 0.8rem;
			background: var(--surface);
			color: var(--muted-foreground);
			border: 1px solid var(--border);
			border-radius: var(--radius-sm);
			font-family: var(--font-mono);
			font-size: var(--text-sm);
		}

		.hero-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
		}

		.btn {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.75rem 1.5rem;
			border-radius: var(--radius-full);
			text-decoration: none;
			font-weight: 600;
			font-size: var(--text-sm);
			transition:
				transform 0.2s var(--ease-out),
				box-shadow 0.2s var(--ease-out),
				border-color 0.2s var(--ease-out);
		}

		.btn-primary {
			background: var(--accent);
			color: var(--accent-foreground);
			border: 1px solid var(--accent);
			box-shadow: var(--glow-accent);
		}

		.btn-primary:hover {
			transform: translateY(-2px);
			box-shadow: 0 0 32px hsla(158, 72%, 56%, 0.3);
		}

		.btn-ghost {
			background: transparent;
			color: var(--foreground);
			border: 1px solid var(--border);
		}

		.btn-ghost:hover {
			border-color: var(--accent);
			color: var(--accent);
			transform: translateY(-2px);
		}

		/* ===== Sections ===== */
		.section {
			padding: clamp(3rem, 7vw, 4.5rem) 0;
		}

		.section-alt {
			background: var(--surface);
			border-top: 1px solid var(--border);
			border-bottom: 1px solid var(--border);
		}

		.section-eyebrow {
			display: block;
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			color: var(--accent);
			letter-spacing: 0.08em;
			margin-bottom: 0.6rem;
		}

		.section-title {
			font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
			margin: 0 0 2.25rem;
		}

		/* ===== 概览 ===== */
		.overview-grid {
			display: grid;
			gap: 1.25rem;
			grid-template-columns: 1fr;
		}

		.overview-card {
			padding: 1.5rem;
			background: var(--background);
			border: 1px solid var(--border);
			border-radius: var(--radius-md);
		}

		.overview-card.wide {
			grid-column: 1 / -1;
		}

		.overview-card h3 {
			font-size: var(--text-sm);
			font-family: var(--font-mono);
			font-weight: 500;
			color: var(--muted-foreground);
			margin: 0 0 1rem;
			letter-spacing: 0.05em;
		}

		.overview-card p {
			color: var(--foreground);
			line-height: 1.8;
			margin: 0;
		}

		.pill-list {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.pill {
			padding: 0.3rem 0.75rem;
			background: color-mix(in srgb, var(--accent) 12%, transparent);
			color: var(--accent);
			border-radius: var(--radius-full);
			font-size: var(--text-sm);
		}

		.pill-dim {
			background: var(--muted);
			color: var(--muted-foreground);
		}

		/* ===== 正文 ===== */
		.content-wrapper {
			max-width: 75ch;
		}

		/* ===== 挑战 ===== */
		.challenges-list {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		.challenge-item {
			display: flex;
			gap: 1.25rem;
			align-items: flex-start;
			padding: 1.5rem;
			background: var(--background);
			border: 1px solid var(--border);
			border-radius: var(--radius-md);
		}

		.challenge-num {
			font-family: var(--font-mono);
			font-size: var(--text-md);
			font-weight: 600;
			color: var(--accent);
			flex-shrink: 0;
		}

		.challenge-item p {
			color: var(--foreground);
			line-height: 1.7;
			margin: 0;
		}

		/* ===== 复盘 ===== */
		.lessons-list {
			display: grid;
			gap: 0.9rem;
			grid-template-columns: 1fr;
		}

		.lesson-item {
			display: flex;
			gap: 0.9rem;
			align-items: flex-start;
			padding: 1.25rem 1.5rem;
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-md);
			color: var(--accent);
		}

		.lesson-item p {
			color: var(--foreground);
			margin: 0;
			line-height: 1.6;
		}

		/* ===== 底部导航 ===== */
		.detail-nav {
			padding: 2.5rem 0 4rem;
		}

		.back-link {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.7rem 1.4rem;
			background: var(--surface);
			color: var(--foreground);
			border: 1px solid var(--border);
			text-decoration: none;
			font-weight: 600;
			font-size: var(--text-sm);
			border-radius: var(--radius-full);
			transition:
				border-color 0.2s var(--ease-out),
				color 0.2s var(--ease-out),
				transform 0.2s var(--ease-out);
		}

		.back-link:hover {
			border-color: var(--accent);
			color: var(--accent);
			transform: translateX(-4px);
		}

		@media (min-width: 50em) {
			.overview-grid {
				grid-template-columns: 1fr 1fr;
			}

			.lessons-list {
				grid-template-columns: 1fr 1fr;
			}
		}
	</style>
</BaseLayout>
