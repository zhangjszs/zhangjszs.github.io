---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Grid from '../../components/Grid.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import TagFilter from '../../components/TagFilter.astro';

const projects = await getCollection('projects');
// 个人项目排在前面，课程实验（labwork）靠后
const sortedProjects = projects.sort((a, b) => {
	if (a.data.category !== b.data.category) return a.data.category === 'personal' ? -1 : 1;
	return 0;
});
const allTags = projects.flatMap((p) => p.data.tags);
const uniqueTags = [...new Set(allTags)];
const allTech = [...new Set(projects.flatMap((p) => p.data.techStack))];
const personalCount = projects.filter((p) => p.data.category === 'personal').length;

// 分类筛选按钮
const categories = [
	{ value: 'personal', label: '个人项目' },
	{ value: 'labwork', label: '课程实验' },
];
---

<BaseLayout title="项目 | Kerwin Zhang" description="个人项目与课程实验作品集。">
	<div class="wrapper" data-pagefind-body>
		<PageHeader
			eyebrow="01 · projects"
			title="项目"
			description="个人项目与课程实验，每个条目都带完整的技术细节与复盘。"
		>
			<p class="stats-line">
				<span><strong>{projects.length}</strong> 项目</span>
				<span class="sep">/</span>
				<span><strong>{personalCount}</strong> 个人</span>
				<span class="sep">/</span>
				<span><strong>{allTech.length}</strong> 技术</span>
				<span class="sep">/</span>
				<span><strong>{uniqueTags.length}</strong> 标签</span>
			</p>
		</PageHeader>

		<TagFilter tags={allTags} categories={categories} />

		<div class="projects-grid" data-reveal>
			<Grid variant="offset">
				{
					sortedProjects.map((project) => (
						<li data-project-tags={JSON.stringify(project.data.tags)} data-project-category={project.data.category}>
							<ProjectCard project={project} />
						</li>
					))
				}
			</Grid>
		</div>
		<div class="page-end"></div>
	</div>

	<script>
		import { initMotion } from '../../scripts/motion/core';
		initMotion();
	</script>

	<style>
		.stats-line {
			display: flex;
			flex-wrap: wrap;
			gap: 0.6rem;
			align-items: baseline;
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			color: var(--muted-foreground);
			margin: 0.5rem 0 0;
		}

		.stats-line strong {
			color: var(--accent);
			font-weight: 600;
		}

		.stats-line .sep {
			color: var(--border);
		}

		.projects-grid {
			margin-top: 2.5rem;
		}

		.page-end {
			height: clamp(3rem, 8vw, 6rem);
		}
	</style>
</BaseLayout>
