---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
	title="404 | 页面不存在"
	description="你访问的页面不存在或已被移动。返回 Kerwin Zhang 的个人主页继续浏览项目与文章。"
>
	<section class="error-section">
		<p class="error-path">
			<span>GET</span>
			<code>{Astro.url.pathname}</code>
			<span class="error-status">404</span>
		</p>
		<span class="error-code" aria-hidden="true">404</span>
		<h1>这一页不在这里</h1>
		<p class="error-desc">你访问的地址不存在，或者内容已经换了位置。从首页或作品列表继续。</p>
		<div class="error-actions">
			<a href={withBase('/')} class="btn btn-primary"> 返回首页 </a>
			<a href={withBase('/projects/')} class="btn">全部作品</a>
		</div>
	</section>

	<style>
		.error-section {
			display: flex;
			flex-direction: column;
			gap: 1rem;
			align-items: flex-start;
			max-width: 46rem;
			padding-block: clamp(4rem, 12vw, 9rem);
		}

		.error-path {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			align-items: baseline;
			margin: 0;
			padding-bottom: 1rem;
			border-bottom: 1px solid var(--border);
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			letter-spacing: 0.04em;
			color: var(--muted-foreground);
			width: 100%;
		}

		.error-path code {
			overflow-wrap: anywhere;
			color: var(--foreground);
		}

		.error-status {
			margin-left: auto;
			color: var(--accent);
		}

		.error-code {
			font-family: var(--font-serif);
			font-size: clamp(5rem, 18vw, 11rem);
			font-weight: 500;
			line-height: 0.9;
			letter-spacing: -0.03em;
			color: var(--foreground);
			opacity: 0.14;
		}

		.error-section h1 {
			margin: 0;
			font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
		}

		.error-desc {
			margin: 0;
			max-width: 46ch;
			color: var(--muted-foreground);
			line-height: 1.8;
		}

		.error-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-top: 1rem;
		}
	</style>
</BaseLayout>
