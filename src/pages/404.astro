---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
	title="404 | 页面不存在"
	description="你访问的页面不存在或已被移动。返回 Kerwin Zhang 的个人主页继续浏览项目与文章。"
>
	<section class="error-section">
		<div class="wrapper">
			<div class="error-content">
				<p class="error-log">
					<span class="log-prompt">~/site $</span> cd {Astro.url.pathname}<br />
					cd: no such file or directory
				</p>
				<span class="error-code" aria-label="404">404</span>
				<h1>页面不存在</h1>
				<p class="error-desc">你正在寻找的页面不存在或已被移动。</p>
				<a href={withBase('/')} class="home-link">
					<Icon icon="arrow-left" size="1.1em" />
					返回首页
				</a>
			</div>
		</div>
	</section>

	<style>
		.error-section {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 80vh;
			text-align: center;
		}

		.error-content {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 1rem;
		}

		.error-log {
			font-family: var(--font-mono);
			font-size: var(--text-sm);
			color: var(--muted-foreground);
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-md);
			padding: 0.9rem 1.4rem;
			text-align: left;
			line-height: 1.8;
			margin: 0;
		}

		.log-prompt {
			color: var(--accent);
		}

		.error-code {
			font-size: clamp(6rem, 15vw, 10rem);
			font-weight: 800;
			font-family: var(--font-brand);
			color: var(--accent);
			text-shadow: 0 0 40px hsla(158, 72%, 56%, 0.3);
			line-height: 1;
			animation: glitch 3s ease-in-out infinite;
		}

		@keyframes glitch {
			0%,
			90%,
			100% {
				text-shadow: 0 0 40px hsla(158, 72%, 56%, 0.3);
				transform: translate(0);
			}
			92% {
				text-shadow:
					2px 0 var(--accent-warm),
					-2px 0 var(--accent);
				transform: translate(-2px, 1px);
			}
			94% {
				text-shadow:
					-2px 0 var(--accent-warm),
					2px 0 var(--accent);
				transform: translate(2px, -1px);
			}
			96% {
				text-shadow:
					2px 0 var(--accent),
					-2px 0 var(--accent-warm);
				transform: translate(-1px, 2px);
			}
		}

		h1 {
			font-size: var(--text-2xl);
			margin: 0;
		}

		.error-desc {
			color: var(--muted-foreground);
			max-width: 40ch;
			margin: 0;
		}

		.home-link {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			margin-top: 1rem;
			padding: 0.75rem 1.5rem;
			background: var(--accent);
			color: var(--accent-foreground);
			border-radius: var(--radius-full);
			text-decoration: none;
			font-weight: 600;
			font-size: var(--text-sm);
			box-shadow: var(--glow-accent);
			transition:
				transform 0.2s var(--ease-out),
				box-shadow 0.2s var(--ease-out);
		}

		.home-link:hover {
			transform: translateY(-2px);
			box-shadow: 0 0 32px hsla(158, 72%, 56%, 0.35);
		}

		@media (prefers-reduced-motion: reduce) {
			.error-code {
				animation: none;
			}
		}
	</style>
</BaseLayout>
