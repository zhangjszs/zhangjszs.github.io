---
import MainHead from '../components/MainHead.astro';
interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
---

<html lang="zh-CN" class="lab-document">
	<head><MainHead title={title} description={description} /><meta name="theme-color" content="#10120f" /></head>
	<body class="lab-body"><a class="lab-skip" href="#main">跳到主要内容</a><slot /></body>
</html>
<style is:global>
	html.lab-document {
		color-scheme: dark;
		--lab-bg: #10120f;
		--lab-text: #efefdf;
		--lab-muted: #a0a598;
		--lab-line: #34382e;
		--lab-accent: #ceff56;
		--background: var(--lab-bg);
		--foreground: var(--lab-text);
		--accent: var(--lab-accent);
		--muted-foreground: var(--lab-muted);
		--border: var(--lab-line);
		--font-brand: var(--font-body);
		scroll-padding-top: 6rem;
	}
	.lab-body {
		margin: 0;
		background: var(--lab-bg);
		color: var(--lab-text);
		font-family: var(--font-body);
		overflow-x: clip;
	}
	.lab-body ::selection {
		background: var(--lab-accent);
		color: var(--lab-bg);
	}
	.lab-body a {
		color: inherit;
		text-decoration: none;
	}
	.lab-body button,
	.lab-body input {
		font: inherit;
	}
	.lab-body :focus-visible {
		outline: 2px solid var(--lab-accent);
		outline-offset: 6px;
	}
	.lab-skip {
		position: fixed;
		top: -6rem;
		left: 1rem;
		z-index: 100;
		padding: 0.8rem 1rem;
		background: var(--lab-accent);
		color: var(--lab-bg) !important;
	}
	.lab-skip:focus {
		top: 1rem;
	}
	@media (prefers-reduced-motion: reduce) {
		.lab-body *,
		.lab-body *::before,
		.lab-body *::after {
			animation: none !important;
			transition: none !important;
		}
	}
</style>
