---
// Learn about using Astro layouts:
// https://docs.astro.build/en/basics/layouts/

import BackToTop from '../components/BackToTop.astro';
import Footer from '../components/Footer.astro';
// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import SearchDialog from '../components/SearchDialog.astro';

// 透传给 MainHead 的 SEO 字段（保持单一事实源：见 src/data/site.ts 与 MainHead.astro 的 Props）
interface Props {
	title?: string | undefined;
	description?: string | undefined;
	ogType?: 'website' | 'article' | undefined;
	publishedTime?: string | undefined;
	author?: string | undefined;
	ogDescription?: string | undefined;
	/** 首页传入本页区块，顶栏渲染为区块导航 */
	sections?: { id: string; label: string }[];
}

const { title, description, ogType, publishedTime, author, ogDescription, sections = [] } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<MainHead
			title={title}
			description={description}
			ogType={ogType}
			publishedTime={publishedTime}
			author={author}
			ogDescription={ogDescription}
		/>
	</head>
	<body>
		<ScrollProgress />
		<a class="skip-link" href="#main">跳到主要内容</a>
		<div class="stack">
			<Nav sections={sections} />
			<main id="main">
				<slot />
			</main>
			<Footer />
		</div>
		<BackToTop />
		<SearchDialog />

		<script>
			// 锚点滚动与焦点转移统一由 src/scripts/motion/core.ts 的 initAnchorScroll 处理

			// Code block copy buttons
			const addCopyButtons = () => {
				document.querySelectorAll('pre').forEach((pre) => {
					if (pre.querySelector('.copy-code-btn')) return;
					const code = pre.querySelector('code');
					if (!code) return;

					const btn = document.createElement('button');
					btn.className = 'copy-code-btn';
					btn.setAttribute('aria-label', '复制代码');
					btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;

					btn.addEventListener('click', async () => {
						try {
							await navigator.clipboard.writeText(code.textContent || '');
							btn.classList.add('copied');
							btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
							setTimeout(() => {
								btn.classList.remove('copied');
								btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
							}, 2000);
						} catch (err) {
							console.error('Failed to copy:', err);
						}
					});

					pre.style.position = 'relative';
					pre.appendChild(btn);
				});
			};

			// Image fade-in on load
			const observeImages = () => {
				document.querySelectorAll('img:not(.img-fade):not([src^="data:"])').forEach((img) => {
					img.classList.add('img-fade');
					if ((img as HTMLImageElement).complete) {
						img.classList.add('loaded');
					} else {
						img.addEventListener('load', () => img.classList.add('loaded'));
						img.addEventListener('error', () => img.classList.add('loaded'));
					}
				});
			};

			// Run after DOM is ready and after any dynamic content loads
			addCopyButtons();
			observeImages();
			const observer = new MutationObserver((mutations) => {
				const hasNewContent = mutations.some((m) => Array.from(m.addedNodes).some((n) => n instanceof Element));
				if (hasNewContent) {
					addCopyButtons();
					observeImages();
				}
			});
			observer.observe(document.body, { childList: true, subtree: true });
		</script>
	</body>
</html>
