---
import { withBase } from '../utils/paths';
import { CONTACT, SITE_NAME, SITE_ROLE } from '../data/site';

const currentYear = new Date().getFullYear();

const footerLinks = [
	{
		title: '导航',
		links: [
			{ label: '首页', href: withBase('/') },
			{ label: '作品', href: withBase('/projects/') },
			{ label: '笔记', href: withBase('/blog/') },
			{ label: '关于', href: withBase('/about/') },
			{ label: '友链', href: withBase('/links/') },
			{ label: '简历', href: withBase('/resume/') },
		],
	},
];

const channels = CONTACT.filter((channel) => channel.href);
---

<footer data-pagefind-ignore>
	<div class="footer-inner">
		<div class="footer-top">
			<div class="footer-brand">
				<a href={withBase('/')} class="brand-link">{SITE_NAME}</a>
				<p class="brand-role">{SITE_ROLE}</p>
			</div>
			<div class="footer-links">
				{
					footerLinks.map((group) => (
						<div class="link-group">
							<h4>{group.title}</h4>
							<ul>
								{group.links.map((link) => (
									<li>
										<a href={link.href}>{link.label}</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
				<div class="link-group">
					<h4>联系</h4>
					<ul>
						{
							channels.map((channel) => (
								<li>
									<a
										href={channel.href}
										target={channel.href!.startsWith('http') ? '_blank' : undefined}
										rel={channel.href!.startsWith('http') ? 'noopener noreferrer' : undefined}
									>
										{channel.label}
									</a>
								</li>
							))
						}
						<li>
							<a href={withBase('/rss.xml')}>RSS</a>
						</li>
					</ul>
				</div>
			</div>
		</div>
		<div class="footer-bottom">
			<p class="copyright">
				&copy; {currentYear}
				{SITE_NAME}
				<span class="sep">/</span>
				站点源码由
				<a href="https://astro.build/">Astro</a>
				构建
			</p>
			<p class="foot-note">站内文字与项目内容均为本人记录，未标注的渠道为待补充。</p>
		</div>
	</div>
</footer>

<style>
	footer {
		margin-top: auto;
		border-top: 1px solid var(--border);
		background: var(--gray-999);
	}

	.footer-inner {
		max-width: var(--max-width-app);
		margin-inline: auto;
		padding: clamp(3rem, 7vw, 4.5rem) clamp(1.25rem, 5vw, 3.5rem) 2rem;
	}

	.footer-top {
		display: grid;
		gap: 2.5rem;
		grid-template-columns: minmax(0, 1fr);
		padding-bottom: 2.5rem;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.brand-link {
		font-family: var(--font-serif);
		font-size: var(--text-2xl);
		font-weight: 500;
		line-height: 1.15;
		color: var(--foreground);
		text-decoration: none;
	}

	.brand-link:hover {
		color: var(--accent);
	}

	.brand-role {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.06em;
		color: var(--muted-foreground);
	}

	.footer-links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
	}

	.link-group h4 {
		margin: 0 0 0.9rem;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.link-group ul {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.link-group a {
		color: var(--muted-foreground);
		font-size: var(--text-sm);
		text-decoration: none;
	}

	.link-group a:hover {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.footer-bottom {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}

	.copyright {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		align-items: baseline;
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.03em;
		color: var(--muted-foreground);
	}

	.copyright .sep {
		color: var(--border-strong);
	}

	.copyright a {
		color: var(--foreground);
		text-decoration: none;
		border-bottom: 1px solid var(--border-strong);
	}

	.copyright a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.foot-note {
		margin: 0;
		font-size: var(--text-xs);
		color: var(--muted-foreground);
	}

	@media (min-width: 56em) {
		.footer-top {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
			gap: 4rem;
		}

		.footer-bottom {
			flex-direction: row;
			justify-content: space-between;
			align-items: baseline;
			gap: 2rem;
		}
	}
</style>
