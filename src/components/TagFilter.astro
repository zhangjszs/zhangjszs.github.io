---
interface Props {
	tags: string[];
	selected?: string[];
	/** 作品分类筛选（可选）：value 对应 frontmatter 的 category 字段 */
	categories?: { value: string; label: string }[];
}

const { tags, selected = [], categories = [] } = Astro.props;
const uniqueTags = [...new Set(tags)].sort();
---

<div class="tag-filter" data-selected={JSON.stringify(selected)}>
	<span class="label">筛选：</span>
	<div class="tags">
		<button class="tag-btn active" data-tag="all">全部</button>
		{
			categories.map((cat) => (
				<button class="tag-btn" data-tag={`category:${cat.value}`}>
					{cat.label}
				</button>
			))
		}
		{
			uniqueTags.map((tag) => (
				<button class="tag-btn" data-tag={tag}>
					{tag}
				</button>
			))
		}
	</div>
</div>

<script>
	const filter = document.querySelector('.tag-filter');
	if (filter) {
		const buttons = filter.querySelectorAll('.tag-btn');
		const projects = document.querySelectorAll('[data-project-tags]');

		const applyFilter = (tag: string) => {
			buttons.forEach((b) => b.classList.remove('active'));
			const activeBtn = Array.from(buttons).find((b) => b.getAttribute('data-tag') === tag);
			if (activeBtn) activeBtn.classList.add('active');
			else buttons[0]?.classList.add('active');

			// 以 category: 开头的按钮按分类过滤，其余按标签过滤
			const isCategory = tag.startsWith('category:');
			const categoryValue = isCategory ? tag.slice('category:'.length) : null;

			projects.forEach((project) => {
				let show: boolean;
				if (tag === 'all') {
					show = true;
				} else if (isCategory) {
					show = project.getAttribute('data-project-category') === categoryValue;
				} else {
					const tags = JSON.parse(project.getAttribute('data-project-tags') || '[]');
					show = tags.includes(tag);
				}
				(project as HTMLElement).style.display = show ? '' : 'none';
			});
		};

		// Read URL query parameter on load, fallback to server-rendered selection
		const params = new URLSearchParams(window.location.search);
		const urlTag = params.get('tag');
		const serverSelected = filter.getAttribute('data-selected');
		const selectedTags = serverSelected ? JSON.parse(serverSelected) : [];
		const initialTag = urlTag || selectedTags[0] || 'all';
		if (initialTag !== 'all') {
			applyFilter(initialTag);
		}

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const tag = btn.getAttribute('data-tag') || 'all';
				applyFilter(tag);
				// Update URL without reloading
				const url = new URL(window.location.href);
				if (tag === 'all') {
					url.searchParams.delete('tag');
				} else {
					url.searchParams.set('tag', tag);
				}
				window.history.replaceState({}, '', url);
			});
		});
	}
</script>

<style>
	.tag-filter {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 2rem;
	}

	.label {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted-foreground);
		font-weight: 500;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.tag-btn {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		padding: 0.35rem 0.7rem;
		background: var(--surface);
		color: var(--muted-foreground);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		cursor: pointer;
		transition:
			color 0.2s var(--ease-out),
			border-color 0.2s var(--ease-out),
			background-color 0.2s var(--ease-out);
	}

	.tag-btn:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.tag-btn.active {
		background: var(--foreground);
		color: var(--gray-999);
		border-color: var(--foreground);
	}
</style>
