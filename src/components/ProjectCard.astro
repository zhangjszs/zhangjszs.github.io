---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/paths';

interface Props {
	project: CollectionEntry<'projects'>;
	/** 卡片序号（等宽章节编号），从 1 开始 */
	index?: number;
	/**
	 * link = 整卡跳详情页；
	 * expand = 整卡仍指向详情页（无 JS 时可用），有 JS 时拦截点击并展开本页 dialog。
	 */
	mode?: 'link' | 'expand';
}

const { project, index = 1, mode = 'link' } = Astro.props;
const { title, description, tags, techStack, category, difficulty, date, role } = project.data;

const num = String(index).padStart(2, '0');
const categoryLabel = category === 'personal' ? '个人项目' : '课程实验';
const year = date ? date.split('-')[0] : '待补充';
const detailHref = withBase(`/projects/${project.id}`);
const panelId = `work-panel-${project.id}`;
const titleId = `work-title-${project.id}`;
// 图版上的首字符：中文标题取首个汉字，英文标题取首字母大写
const glyph = /[一-龥]/.test(title[0]) ? title[0] : title[0].toUpperCase();
---

<article class:list={['work', `work-${mode}`]}>
	<div class="work-plate" aria-hidden="true">
		<span class="plate-glyph">{glyph}</span>
		<span class="plate-slug">{project.id}</span>
		<span class="plate-lines"></span>
		<span class="plate-tech">{techStack.join(' · ')}</span>
	</div>
	<div class="work-body">
		<p class="work-kicker">
			<span class="work-num">{num}</span>
			<span>{categoryLabel}</span>
			<span class="work-sep" aria-hidden="true">/</span>
			<span class="work-year">{year}</span>
			{
				difficulty && (
					<span class="work-sep" aria-hidden="true">
						/
					</span>
				)
			}
			{difficulty && <span>{difficulty}</span>}
		</p>
		<h3 class="work-title" id={titleId}>
			<a
				class="work-hit"
				href={detailHref}
				aria-haspopup={mode === 'expand' ? 'dialog' : undefined}
				aria-controls={mode === 'expand' ? panelId : undefined}
				data-work-open={mode === 'expand' ? panelId : undefined}
			>
				{title}
			</a>
		</h3>
		<p class="work-desc">{description}</p>
		<p class="work-role">
			<span class="work-role-k">职责</span>
			<span class="work-role-v">{role ?? '待补充'}</span>
		</p>
		<ul class="work-tags">
			{tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
			{tags.length > 4 && <li class="work-more">+{tags.length - 4}</li>}
		</ul>
		{
			mode === 'expand' && (
				<span class="work-cta" aria-hidden="true">
					展开 · 背景 / 职责 / 成果
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<path d="M5 12h14M13 6l6 6-6 6" />
					</svg>
				</span>
			)
		}
	</div>
</article>

<style>
	.work {
		position: relative;
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 0;
		transition:
			border-color 0.25s var(--ease-out),
			box-shadow 0.25s var(--ease-out);
	}

	.work:hover {
		border-color: var(--border-strong);
		box-shadow: var(--shadow-md);
	}

	/* ===== 图版（排印式视觉预览，非项目截图） ===== */
	.work-plate {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 5 / 2;
		overflow: hidden;
		border-bottom: 1px solid var(--border);
		background-color: var(--background);
		background-image: repeating-linear-gradient(90deg, var(--border) 0 1px, transparent 1px 14px);
	}

	.plate-glyph {
		font-family: var(--font-serif);
		font-size: clamp(3.5rem, 12vw, 5.5rem);
		font-weight: 500;
		line-height: 1;
		color: var(--foreground);
		opacity: 0.16;
		user-select: none;
	}

	.plate-slug {
		position: absolute;
		top: 0.65rem;
		left: 0.85rem;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.02em;
		color: var(--muted-foreground);
		max-width: 75%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* 一条浅褐刻度线，标记这是图版而非照片 */
	.plate-lines {
		position: absolute;
		left: 0.85rem;
		right: 0.85rem;
		bottom: 2.4rem;
		height: 1px;
		background: repeating-linear-gradient(90deg, var(--border-strong) 0 1px, transparent 1px 6px);
	}

	.plate-tech {
		position: absolute;
		left: 0.85rem;
		right: 0.85rem;
		bottom: 0.7rem;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--accent);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* ===== 正文 ===== */
	.work-body {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.35rem clamp(1.1rem, 3vw, 1.6rem) 1.5rem;
	}

	.work-kicker {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.45rem;
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.06em;
		color: var(--muted-foreground);
	}

	.work-num {
		color: var(--accent);
	}

	.work-sep {
		color: var(--border-strong);
	}

	.work-year {
		font-variant-numeric: tabular-nums;
	}

	.work-title {
		margin: 0.15rem 0 0;
		font-size: var(--text-xl);
		line-height: 1.28;
	}

	/* 标题即为触发器；::after 把命中区域撑到整张卡片 */
	.work-hit {
		display: inline;
		color: var(--foreground);
		text-decoration: none;
		transition: color 0.2s var(--ease-out);
	}

	.work-hit::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.work-hit:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.work:hover .work-hit,
	.work-hit:focus-visible {
		color: var(--accent);
	}

	.work-desc {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.7;
		color: var(--muted-foreground);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.work-role {
		display: flex;
		gap: 0.6rem;
		align-items: baseline;
		margin: 0.2rem 0 0;
		padding-top: 0.75rem;
		border-top: 1px solid var(--border);
		font-size: var(--text-sm);
	}

	.work-role-k {
		flex-shrink: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.06em;
		color: var(--muted-foreground);
	}

	.work-role-v {
		color: var(--foreground);
	}

	.work-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.9rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--muted-foreground);
	}

	.work-tags li + li::before {
		content: '/';
		margin-right: 0.5rem;
		color: var(--border-strong);
	}

	.work-more {
		color: var(--accent);
	}

	.work-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 0.35rem;
		font-size: var(--text-sm);
		color: var(--accent);
	}

	@media (min-width: 40em) {
		.work-plate {
			aspect-ratio: 16 / 7;
		}
	}
</style>
