---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/paths';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, tags, techStack, featured, difficulty } = project.data;
---

<a class={`card ${featured ? 'featured' : ''}`} href={withBase(`/projects/${project.id}`)}>
	<div class="card-cover">
		<span class="cover-glyph">{title.charAt(0)}</span>
		<span class="cover-id">{project.id}</span>
		<div class="cover-badges">
			{featured && <span class="featured-badge">精选</span>}
			{difficulty && <span class="difficulty-badge">{difficulty}</span>}
		</div>
		<div class="cover-scan" aria-hidden="true"></div>
	</div>
	<div class="card-content">
		<h3 class="card-title">{title}</h3>
		<p class="card-description">{description}</p>
		<div class="card-tags">
			{tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
			{tags.length > 3 && <span class="tag more">+{tags.length - 3}</span>}
		</div>
		<div class="card-tech">
			{techStack.slice(0, 4).map((tech) => <span class="tech">{tech}</span>)}
		</div>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.35s var(--ease-out),
			box-shadow 0.35s var(--ease-out),
			border-color 0.35s var(--ease-out);
		overflow: hidden;
		height: 100%;
	}

	.card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg), var(--glow-accent);
		border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
	}

	.card.featured {
		border-color: color-mix(in srgb, var(--accent) 55%, transparent);
	}

	.card.featured:hover {
		border-color: var(--accent);
		box-shadow:
			var(--shadow-lg),
			0 0 0 1px var(--accent),
			var(--glow-accent);
	}

	/* 封面：石墨底 + 点阵 + 大字形 + 扫描线 */
	.card-cover {
		position: relative;
		height: 148px;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		background:
			radial-gradient(90% 80% at 50% 0%, hsla(158, 72%, 56%, 0.07), transparent 70%),
			radial-gradient(circle at 1px 1px, var(--gray-600) 1px, transparent 0) 0 0 / 22px 22px,
			var(--gray-900);
		border-bottom: 1px solid var(--border);
	}

	.cover-glyph {
		font-size: 4rem;
		font-weight: 700;
		font-family: var(--font-mono);
		color: color-mix(in srgb, var(--accent) 75%, transparent);
		text-shadow: 0 0 28px hsla(158, 72%, 56%, 0.35);
		letter-spacing: -0.04em;
		user-select: none;
	}

	.cover-id {
		position: absolute;
		left: 0.9rem;
		bottom: 0.6rem;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--gray-400);
		max-width: 70%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.cover-badges {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		display: flex;
		gap: 0.4rem;
	}

	.featured-badge {
		padding: 0.2rem 0.65rem;
		background: var(--accent);
		color: var(--accent-foreground);
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		font-weight: 600;
	}

	.difficulty-badge {
		padding: 0.2rem 0.55rem;
		background: color-mix(in srgb, var(--background) 70%, transparent);
		color: var(--muted-foreground);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-size: var(--text-xs);
		backdrop-filter: blur(4px);
	}

	/* hover 时扫过封面的激光线 */
	.cover-scan {
		position: absolute;
		inset: 0 auto 0 0;
		width: 2px;
		background: linear-gradient(180deg, transparent, var(--accent), transparent);
		opacity: 0;
		transform: translateX(-8px);
		transition: none;
	}

	.card:hover .cover-scan {
		opacity: 0.9;
		animation: scan 1.1s var(--ease-out) both;
	}

	@keyframes scan {
		from {
			transform: translateX(-8px);
		}
		to {
			transform: translateX(100vw);
		}
	}

	.card-content {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		flex: 1;
		gap: 0.75rem;
	}

	.card-title {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--foreground);
		line-height: 1.3;
		font-weight: 600;
	}

	.card-description {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--muted-foreground);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: 1;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tag {
		font-size: var(--text-xs);
		padding: 0.2rem 0.6rem;
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		color: var(--accent);
		border-radius: var(--radius-full);
		font-weight: 500;
	}

	.tag.more {
		background: var(--muted);
		color: var(--muted-foreground);
	}

	.card-tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding-top: 0.6rem;
		border-top: 1px solid var(--border);
	}

	.tech {
		font-size: var(--text-xs);
		padding: 0.15rem 0.5rem;
		background: var(--muted);
		color: var(--muted-foreground);
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.cover-scan {
			transition: none;
			animation: none;
		}
		.card:hover {
			transform: none;
		}
		.card:hover .cover-scan {
			opacity: 0;
		}
	}
</style>
