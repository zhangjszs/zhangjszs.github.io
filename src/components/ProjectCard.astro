---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/paths';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, tags, techStack, featured, difficulty } = project.data;

// 莫兰迪渐变（与 global.css 莫兰迪主色一致：雾绿 + 旧玫瑰 + 暖灰）
// 用标题字符数取模，确保同一项目颜色稳定
const gradients = [
	'linear-gradient(135deg, #8a9a8b 0%, #5e6e60 100%)', // 雾绿
	'linear-gradient(135deg, #c4a4a7 0%, #8a9a8b 100%)', // 玫瑰 → 雾绿
	'linear-gradient(135deg, #b5c4b6 0%, #6b6e6c 100%)', // 浅绿 → 灰
	'linear-gradient(135deg, #d8dbd9 0%, #8a9a8b 100%)', // 浅灰 → 雾绿
	'linear-gradient(135deg, #c4a4a7 0%, #5e6e60 100%)', // 玫瑰 → 森绿
	'linear-gradient(135deg, #efece6 0%, #b5c4b6 100%)', // 米白 → 浅绿
];
const gradientIndex = title.length % gradients.length;
const gradient = gradients[gradientIndex];
---

<a class={`card ${featured ? 'featured' : ''}`} href={withBase(`/projects/${project.id}`)}>
	<div class="card-cover" style={`background: ${gradient}`}>
		<div class="cover-overlay">
			<span class="cover-icon">{title.charAt(0)}</span>
			{featured && <span class="featured-badge">Featured</span>}
			{difficulty && <span class="difficulty-badge">{difficulty}</span>}
		</div>
	</div>
	<div class="card-content">
		<h3 class="card-title">{title}</h3>
		<p class="card-description">{description}</p>
		<div class="card-tags">
			{tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
			{tags.length > 3 && <span class="tag more">+{tags.length - 3}</span>}
		</div>
		<div class="card-tech">
			{techStack.slice(0, 4).map((tech) => <span class="tech">{tech}</span>)}
		</div>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.35s var(--ease-out),
			box-shadow 0.35s var(--ease-out),
			border-color 0.35s var(--ease-out);
		overflow: hidden;
		height: 100%;
	}

	/* 浮起 + 阴影，更克制（不再 3D 倾斜，那效果花哨且容易让人晕） */
	.card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
		border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
	}

	.card.featured {
		border-color: color-mix(in srgb, var(--accent) 60%, transparent);
	}

	.card.featured:hover {
		border-color: var(--accent);
		box-shadow:
			var(--shadow-lg),
			0 0 0 1px var(--accent);
	}

	.card-cover {
		position: relative;
		height: 140px;
		overflow: hidden;
	}

	/* 封面在 hover 时轻微缩放，更生动 */
	.card-cover::before {
		content: '';
		position: absolute;
		inset: 0;
		background: inherit;
		transition: transform 0.6s var(--ease-out);
		z-index: 0;
	}
	.card:hover .card-cover::before {
		transform: scale(1.06);
	}

	.cover-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1;
	}

	.cover-icon {
		font-size: 3rem;
		font-weight: 700;
		color: rgba(255, 255, 255, 0.95);
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
		font-family: var(--font-brand);
		letter-spacing: -0.02em;
	}

	.featured-badge {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		padding: 0.2rem 0.65rem;
		background: rgba(255, 255, 255, 0.95);
		color: var(--accent-dark);
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.difficulty-badge {
		position: absolute;
		bottom: 0.75rem;
		left: 0.75rem;
		padding: 0.2rem 0.55rem;
		background: rgba(0, 0, 0, 0.4);
		color: white;
		border-radius: var(--radius-sm);
		font-size: var(--text-xs);
		backdrop-filter: blur(4px);
		font-weight: 500;
	}

	.card-content {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		flex: 1;
		gap: 0.75rem;
	}

	.card-title {
		margin: 0;
		font-size: var(--text-lg);
		color: var(--foreground);
		line-height: 1.3;
		font-weight: 600;
	}

	.card-description {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--muted-foreground);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: 1;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tag {
		font-size: var(--text-xs);
		padding: 0.2rem 0.6rem;
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		color: var(--accent);
		border-radius: var(--radius-full);
		font-weight: 500;
	}

	.tag.more {
		background: var(--muted);
		color: var(--muted-foreground);
	}

	.card-tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding-top: 0.6rem;
		border-top: 1px solid var(--border);
	}

	.tech {
		font-size: var(--text-xs);
		padding: 0.15rem 0.5rem;
		background: var(--muted);
		color: var(--muted-foreground);
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.card-cover::before {
			transition: none;
		}
		.card:hover {
			transform: none;
		}
	}
</style>
