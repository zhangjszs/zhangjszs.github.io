---
import Icon from './Icon.astro';
import { withBase } from '../utils/paths';
import { SITE_NAME, SITE_ROLE, CONTACT } from '../data/site';

interface Props {
	/**
	 * 首页传入本页区块锚点，顶栏即变成「区块导航」（滚动时高亮当前区块）；
	 * 内页不传，顶栏退回页面级导航。
	 */
	sections?: { id: string; label: string }[];
}

const { sections = [] } = Astro.props;

const pageLinks: { label: string; href: string }[] = [
	{ label: '首页', href: withBase('/') },
	{ label: '作品', href: withBase('/projects/') },
	{ label: '笔记', href: withBase('/blog/') },
	{ label: '关于', href: withBase('/about/') },
	{ label: '联系', href: withBase('/#contact') },
];

/** 有区块锚点时导航指向本页区块，否则指向其他页面 */
const navItems = sections.length
	? sections.map((section, i) => ({
			label: section.label,
			href: `#${section.id}`,
			num: String(i + 1).padStart(2, '0'),
		}))
	: pageLinks.map((link, i) => ({ ...link, num: String(i + 1).padStart(2, '0') }));

/** Test if a link is pointing to the current page. */
const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	return pathname === href || (href !== '/' && pathname.startsWith(href));
};

const channels = CONTACT.filter((channel) => channel.href);
---

<nav id="main-nav" data-pagefind-ignore data-section-nav={sections.length > 0 || undefined}>
	<div class="nav-bar">
		<a href={withBase('/')} class="brand">
			<span class="brand-name">{SITE_NAME}</span>
			<span class="brand-role">{SITE_ROLE}</span>
		</a>
		<div class="nav-bar-actions">
			<button class="search-trigger" type="button" aria-label="搜索全站内容" data-search-open>
				<Icon icon="magnifying-glass" size="1.05em" />
				<span class="search-label">搜索</span>
			</button>
			<menu-button>
				<template>
					<button class="menu-button" aria-expanded="false">
						<span class="sr-only">展开导航</span>
						<Icon icon="list" />
					</button>
				</template>
			</menu-button>
		</div>
	</div>
	<noscript>
		<ul class="nav-items">
			{
				navItems.map(({ label, href, num }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>
							<span class="link-num">{num}</span>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<div class="socials">
				{
					channels.map(({ label, href }) => (
						<a href={href!} class="social">
							<span class="sr-only">{label}</span>
							{label}
						</a>
					))
				}
			</div>
		</div>
	</noscript>
	<div id="menu-content" hidden>
		<ul class="nav-items">
			{
				navItems.map(({ label, href, num }) => (
					<li>
						<a
							aria-current={isCurrentPage(href) ? 'page' : null}
							class="link"
							href={href}
							data-spy={href.startsWith('#') ? href.slice(1) : undefined}
						>
							<span class="link-num">{num}</span>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<div class="socials">
				{
					channels.map(({ label, href }) => (
						<a
							href={href!}
							class="social"
							target={href!.startsWith('http') ? '_blank' : undefined}
							rel={href!.startsWith('http') ? 'noopener noreferrer' : undefined}
						>
							<span class="sr-only">{label}</span>
							{label}
						</a>
					))
				}
			</div>
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			// Inject menu toggle button when JS runs.
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;

			// Hide menu (shown by default to support no-JS browsers).
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;
			// Add "menu-content" class in JS to avoid covering content in non-JS browsers.
			menu.classList.add('menu-content');

			/** Set whether the menu is currently expanded or collapsed. */
			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			// Toggle menu visibility when the menu button is clicked.
			btn.addEventListener('click', () => setExpanded(menu.hidden === true));

			// Hide menu button for large screens.
			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			const mediaQueries = window.matchMedia('(min-width: 56em)');
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);

			// Esc 收起移动端导航（展开时把焦点还给按钮）
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
					setExpanded(false);
					btn.focus();
				}
			});

			initSectionSpy();
		}
	}
	customElements.define('menu-button', MenuButton);

	/** 区块导航：滚动时高亮当前所在区块（仅首页传入 sections 时生效） */
	function initSectionSpy() {
		const nav = document.getElementById('main-nav');
		if (!nav || !nav.hasAttribute('data-section-nav')) return;

		const links = Array.from(nav.querySelectorAll<HTMLElement>('.link[data-spy]'));
		const byId = new Map(links.map((link) => [link.dataset.spy!, link]));
		const sections = Array.from(byId.keys())
			.map((id) => document.getElementById(id))
			.filter((el): el is HTMLElement => el !== null);
		if (sections.length === 0) return;

		const mark = (activeId: string) => {
			links.forEach((link) => {
				const active = link.dataset.spy === activeId;
				link.classList.toggle('is-current', active);
				if (active) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			});
		};

		// 判定线取视口上沿往下 25%。桌面端左栏作品与右栏区块并排，
		// 同一条判定线会同时穿过两个区块，无法唯一判定当前区块，因此只在单栏堆叠时高亮。
		const stacked = window.matchMedia('(max-width: 67.99em)');
		const evaluate = () => {
			if (!stacked.matches) {
				mark('');
				return;
			}
			const probe = window.scrollY + window.innerHeight * 0.25;
			let current = sections[0];
			for (const section of sections) {
				if (section.offsetTop <= probe) current = section;
			}
			mark(current.id);
		};

		stacked.addEventListener('change', evaluate);

		evaluate();
		window.addEventListener('scroll', evaluate, { passive: true });
		window.addEventListener('resize', evaluate);
	}
</script>

<style>
	nav {
		position: sticky;
		top: 0;
		z-index: 9999;
		background: color-mix(in srgb, var(--gray-999) 92%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--border);
	}

	.nav-bar {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		max-width: var(--max-width-app);
		margin-inline: auto;
		padding: 1.1rem clamp(1.25rem, 5vw, 3.5rem);
	}

	.brand {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		color: inherit;
		text-decoration: none;
	}

	.brand-name {
		font-family: var(--font-serif);
		font-size: var(--text-lg);
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.1;
		color: var(--foreground);
	}

	.brand-role {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.06em;
		color: var(--muted-foreground);
	}

	.nav-bar-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.search-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.6rem;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.04em;
		color: var(--muted-foreground);
		background: transparent;
		border: 1px solid var(--border);
		border-radius: 0;
		cursor: pointer;
		transition:
			color 0.2s var(--ease-out),
			border-color 0.2s var(--ease-out);
	}

	.search-trigger:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.menu-button {
		display: flex;
		padding: 0.3rem 0.5rem;
		font-size: var(--text-xl);
		color: var(--muted-foreground);
		background: transparent;
		border: 1px solid var(--border);
		border-radius: 0;
		cursor: pointer;
	}

	.menu-button[aria-expanded='true'] {
		color: var(--accent);
		border-color: var(--accent);
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-content {
		position: absolute;
		left: 0;
		right: 0;
	}

	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		list-style: none;
		padding: 0.75rem clamp(1.25rem, 5vw, 3.5rem) 1rem;
		background-color: var(--gray-999);
		border-bottom: 1px solid var(--border);
	}

	.link {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.35rem 0;
		color: var(--gray-200);
		font-size: var(--text-sm);
		text-decoration: none;
	}

	.link-num {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.08em;
		color: var(--border-strong);
	}

	.link:hover,
	.link:focus {
		color: var(--accent);
	}

	.link:hover .link-num,
	.link:focus .link-num,
	.link.is-current .link-num {
		color: var(--accent);
	}

	.link[aria-current] {
		color: var(--foreground);
	}

	.link.is-current {
		color: var(--foreground);
		box-shadow: inset 0 -1px 0 0 var(--accent);
	}

	.menu-footer {
		display: flex;
		gap: 1.25rem;
		padding: 0.9rem clamp(1.25rem, 5vw, 3.5rem);
		background-color: var(--gray-999);
		border-bottom: 1px solid var(--border);
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	.social {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.04em;
		color: var(--muted-foreground);
		text-decoration: none;
	}

	.social:hover,
	.social:focus {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (min-width: 56em) {
		nav {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr) auto auto;
			align-items: center;
			gap: 2rem;
			max-width: none;
			padding: 0 clamp(1.25rem, 5vw, 3.5rem);
		}

		/* 顶栏一行四段：姓名 | 区块导航 | 搜索 | 渠道 —— display: contents 摊平包装层后按列定位 */
		.nav-bar {
			display: contents;
		}

		.brand {
			grid-area: 1 / 1;
		}

		.menu-content {
			display: contents;
		}

		.nav-items {
			grid-area: 1 / 2;
			flex-direction: row;
			justify-content: center;
			gap: 2rem;
			padding: 0;
			border: 0;
			background: transparent;
		}

		.nav-bar-actions {
			grid-area: 1 / 3;
			gap: 1.25rem;
		}

		.menu-footer {
			grid-area: 1 / 4;
			padding: 0;
			border: 0;
			background: transparent;
		}

		.search-label {
			display: none;
		}

		.socials {
			gap: 0.9rem;
		}

		.social::before {
			content: '/';
			margin-right: 0.45rem;
			color: var(--border-strong);
		}
	}

	@media (forced-colors: active) {
		.link[aria-current],
		.link.is-current {
			color: SelectedItem;
		}
	}
</style>
