---
// Giscus 评论（GitHub Discussions 驱动，零后端）。
// 用户需在 giscus.app 安装 giscus GitHub App 到本仓库；未安装时读取与发表均不可用
// （giscus.app/api/discussions 直接 403），此时下方脚本会隐藏整个评论区，避免访客看到报错框。
import Icon from './Icon.astro';

const REPO = 'zhangjszs/zhangjszs.github.io';
const REPO_ID = 'R_kgDOUHOyDA';
const CATEGORY = 'General';
const CATEGORY_ID = 'DIC_kwDOUHOyDM4DEmPH';
---

<section class="comments" data-pagefind-ignore>
	<h2 class="comments-title">
		<Icon icon="envelope" size="1em" />
		评论
	</h2>
	<div
		class="giscus"
		id="giscus-anchor"
		data-repo={REPO}
		data-repo-id={REPO_ID}
		data-category={CATEGORY}
		data-category-id={CATEGORY_ID}
	>
	</div>
</section>

<style>
	.comments {
		padding: clamp(2.5rem, 6vw, 4rem) 0 0;
	}

	.comments-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--text-xl);
		margin: 0 0 1.5rem;
	}

	.comments-title :global(svg) {
		color: var(--accent);
	}

	/* 降级兜底：giscus App 未安装时由脚本打上 hidden，显式确保不渲染 */
	.comments[hidden] {
		display: none;
	}
</style>

<script>
	// 配置从锚点 data-* 读取；进视口才懒加载 giscus 脚本
	const anchor = document.getElementById('giscus-anchor');
	if (anchor) {
		const load = () => {
			if (anchor.querySelector('iframe')) return;
			const script = document.createElement('script');
			script.src = 'https://giscus.app/client.js';
			script.setAttribute('data-repo', anchor.dataset.repo ?? '');
			script.setAttribute('data-repo-id', anchor.dataset.repoId ?? '');
			script.setAttribute('data-category', anchor.dataset.category ?? '');
			script.setAttribute('data-category-id', anchor.dataset.categoryId ?? '');
			script.setAttribute('data-mapping', 'pathname');
			script.setAttribute('data-strict', '0');
			script.setAttribute('data-reactions-enabled', '1');
			script.setAttribute('data-emit-metadata', '0');
			script.setAttribute('data-input-position', 'top');
			script.setAttribute('data-theme', 'transparent_light');
			script.setAttribute('data-lang', 'zh-CN');
			script.crossOrigin = 'anonymous';
			script.async = true;
			anchor.appendChild(script);
		};
		new IntersectionObserver(
			(entries, obs) => {
				if (entries.some((e) => e.isIntersecting)) {
					load();
					obs.disconnect();
				}
			},
			{ rootMargin: '400px' }
		).observe(anchor);

		// giscus GitHub App 未安装时，其 iframe 会向父页面投递
		// {giscus:{error:"giscus is not installed on this repository"}}（origin 为 giscus.app）。
		// 命中即整体隐藏评论区，避免访客看到裸露报错框；App 安装后该信号不再出现，评论区正常渲染。
		const hideOnNotInstalled = (event: MessageEvent) => {
			if (event.origin !== 'https://giscus.app') return;
			const error = (event.data as { giscus?: { error?: string } } | null)?.giscus?.error;
			if (typeof error !== 'string' || !/not installed/i.test(error)) return;
			anchor.closest('.comments')?.setAttribute('hidden', '');
			window.removeEventListener('message', hideOnNotInstalled);
		};
		window.addEventListener('message', hideOnNotInstalled);
	}
</script>
