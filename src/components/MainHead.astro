---
import '../styles/global.css';
// 自托管字体（避免 Google Fonts / jsDelivr CDN 在中国大陆访问缓慢）。
// 三个 latin 可变字体额外走 preload：生产 LCP 元素（首屏文字）含拉丁字符，
// font-display: swap 下其重绘时间受字体到达时间约束；经 ?url 拿到 Vite 哈希地址，
// 在 head 解析阶段即发起字体请求，避免等 render-blocking 资源解析完才发现 @font-face。
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/source-serif-4/wght.css';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import jetbrainsMonoLatinWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import sourceSerifLatinWoff2 from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import { withBase } from '../utils/paths';
import { SITE_NAME, SITE_DESCRIPTION, SITE_AUTHOR, SITE_LOCALE } from '../data/site';

// ============================================================
// 站点级元数据：站名 / 描述。改 src/data/site.ts 即同步全站。
// ============================================================

interface Props {
	/** 完整标题（已含站点后缀也可），不传则使用站名 */
	title?: string | undefined;
	/** 描述，不传则使用站点默认描述 */
	description?: string | undefined;
	/** og:type，默认 website；详情页传 'article' */
	ogType?: 'website' | 'article' | undefined;
	/** og:article:published_time（ISO 字符串），仅 ogType=article 时使用 */
	publishedTime?: string | undefined;
	/** og:article:author 覆盖，不传则用 SITE_AUTHOR */
	author?: string | undefined;
	/** 避免 description 与 og:description 重复：若未传则与 description 同值 */
	ogDescription?: string | undefined;
}

const {
	title = SITE_NAME,
	description = SITE_DESCRIPTION,
	ogType = 'website',
	publishedTime,
	author = SITE_AUTHOR,
	ogDescription,
} = Astro.props;

// 社交分享图：withBase 兼容 base 配置；经 new URL(相对路径, site) 得到绝对地址。
// 注意不能直接模板拼 BASE_URL（默认为 '/'，会拼出 '//og-image.png' 协议相对 URL）。
const ogImage = new URL(withBase('/og-image.png'), Astro.site);
const finalOgDescription = ogDescription ?? description;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<meta name="description" content={description} />
<meta name="author" content={author} />
<meta property="og:title" content={title} />
<meta property="og:description" content={finalOgDescription} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={SITE_LOCALE} />
<meta property="og:locale:alternate" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{
	ogType === 'article' && publishedTime && (
		<>
			<meta property="article:published_time" content={publishedTime} />
			<meta property="article:author" content={author} />
		</>
	)
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={finalOgDescription} />

<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="icon" href={withBase('/favicon.ico')} />
<!-- 首屏关键字体预热（fonts 天然 anonymous，同源也必须带 crossorigin） -->
<link rel="preload" as="font" type="font/woff2" href={interLatinWoff2} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={jetbrainsMonoLatinWoff2} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={sourceSerifLatinWoff2} crossorigin />
<!-- RSS 自动发现：浏览器/Reader 会在地址栏给出 RSS 订阅按钮 -->
<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} · RSS`} href={withBase('/rss.xml')} />
<!-- sitemap 链接：搜索引擎爬虫可据此发现全部页面 -->
<link rel="sitemap" type="application/xml" href={withBase('/sitemap-index.xml')} />
<link rel="canonical" href={Astro.url} />
{
	import.meta.env.PROD && (
		<script is:inline data-goatcounter="https://zhangjszs.goatcounter.com/count" async src="//gc.zgo.at/count.js" />
	)
}
