---
import '../styles/global.css';
// 自托管字体（避免 Google Fonts / jsDelivr CDN 在中国大陆访问缓慢）
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/cal-sans/400.css';
import { withBase } from '../utils/paths';

// ============================================================
// TODO: 站点基础信息占位符 —— 全局搜索 TODO: 即可定位
// ============================================================
const SITE_NAME = 'Kerwin Zhang'; // 站点名（Nav/Footer/index/about 共用，改这里即可）
const SITE_DESCRIPTION = '自动驾驶工程学生 · 项目作品、技术笔记与联系方式。'; // 站点描述（SEO / 社交分享）

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title = SITE_NAME, description = SITE_DESCRIPTION } = Astro.props;

// 社交分享图的完整地址由 astro.config.mjs 的 site + base 派生
const ogImage = new URL(`${import.meta.env.BASE_URL}/og-image.png`, Astro.site);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="icon" href={withBase('/favicon.ico')} />
<!-- RSS 自动发现：浏览器/Reader 会在地址栏给出 RSS 订阅按钮 -->
<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} · RSS`} href={withBase('/rss.xml')} />
<!-- sitemap 链接：搜索引擎爬虫可据此发现全部页面 -->
<link rel="sitemap" type="application/xml" href={withBase('/sitemap-index.xml')} />
<link rel="canonical" href={Astro.url} />
{
	import.meta.env.PROD && (
		<script is:inline data-goatcounter="https://zhangjszs.goatcounter.com/count" async src="//gc.zgo.at/count.js" />
	)
}
