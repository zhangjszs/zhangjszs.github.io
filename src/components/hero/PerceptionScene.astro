		<p data-scene-caption>从局部回波到锥桶地标，再到可行驶路径。</p>
	</div>

	<div class="scene-control-deck">
		<div class="fsac-control-row" data-fsac-controls>
			<div class="scene-layers" role="group" aria-label="感知显示层" data-fsac-layers>
				<button type="button" data-fsac-layer="raw" aria-pressed="false" disabled>原始回波</button>
				<button type="button" data-fsac-layer="clusters" aria-pressed="true" disabled>锥桶聚类</button>
				<button type="button" data-fsac-layer="map" aria-pressed="false" disabled>累计地图</button>
			</div>
			<div class="scene-view-controls">
				<button type="button" data-fsac-follow aria-pressed="true" disabled>跟车视角</button>
				<button type="button" data-fsac-reset disabled>重放 ↺</button>
			</div>
		</div>
		<div class="scene-controls" aria-label="三维演示控制">
			<div class="scene-modes" role="group" aria-label="选择演示模式">
				<button type="button" data-scene-mode="perception" aria-pressed="true" disabled><span>01</span> 感知</button>
				<button type="button" data-scene-mode="planning" aria-pressed="false" disabled><span>02</span> 规划</button>
				<button type="button" data-scene-mode="orbit" aria-pressed="false" disabled><span>03</span> 轨道</button>
			</div>
			<label class="scene-speed"
				>演示速度 <output data-scene-speed-value>1×</output><input
					type="range"
					min="0.25"
					max="2"
					step="0.25"
					value="1"
					aria-label="程序化演示速度倍数"
					data-scene-speed
					disabled
				/></label
			>
			<button type="button" class="scene-pause" data-scene-pause aria-pressed="false" aria-label="暂停三维演示" disabled
				><span data-scene-pause-label>暂停 II</span></button
