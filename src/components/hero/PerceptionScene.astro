---
// The fallback and live renderer share the same original procedural course.
import { createFsacCourse } from '../../scripts/fsac-track';
import { withBase } from '../../utils/paths';

const fallbackCourse = createFsacCourse('autocross');
const bounds = fallbackCourse.cones.reduce(
	(box, cone) => ({
		minX: Math.min(box.minX, cone.x),
		maxX: Math.max(box.maxX, cone.x),
		minZ: Math.min(box.minZ, cone.z),
		maxZ: Math.max(box.maxZ, cone.z),
	}),
	{ minX: Infinity, maxX: -Infinity, minZ: Infinity, maxZ: -Infinity }
);
const scale = Math.min(760 / (bounds.maxX - bounds.minX), 390 / (bounds.maxZ - bounds.minZ));
const project = (point: { x: number; z: number }) => ({
	x: 500 + (point.x - (bounds.minX + bounds.maxX) / 2) * scale,
	y: 315 - (point.z - (bounds.minZ + bounds.maxZ) / 2) * scale,
});
const fallbackPath =
	fallbackCourse.samples
		.map((point, i) => {
			const p = project(point);
			return `${i ? 'L' : 'M'}${p.x.toFixed(2)},${p.y.toFixed(2)}`;
		})
		.join(' ') + 'Z';
const fallbackCar = project(fallbackCourse.samples[0]);
---

<div class="perception-scene" data-perception-scene data-mode="perception" data-state="static">
	<div class="scene-fallback" aria-hidden="true">
		<svg viewBox="0 0 1000 680" fill="none" preserveAspectRatio="xMidYMid meet">
			<defs>
				<pattern id="sandbox-grid" width="40" height="40" patternUnits="userSpaceOnUse">
					<path d="M40 0H0V40" stroke="#293025" stroke-width="1"></path>
				</pattern>
			</defs>
			<rect width="1000" height="680" fill="#10120f"></rect>
			<rect width="1000" height="680" fill="url(#sandbox-grid)"></rect>
			<path d={fallbackPath} stroke="#20291a" stroke-width={fallbackCourse.width * scale} stroke-linejoin="round"
			></path>
			<path d={fallbackPath} stroke="#ceff56" stroke-opacity=".75" stroke-width="1.6" stroke-dasharray="6 7"></path>
			{
				fallbackCourse.cones.map((cone) => {
					const point = project(cone);
					return (
						<path
							d={`M${point.x},${point.y - 3.3}l3.1,5.8h-6.2Z`}
							fill={cone.side === 'left' ? '#ff6458' : cone.side === 'right' ? '#66b9ff' : '#f5d35d'}
						/>
					);
				})
			}
			<g transform={`translate(${fallbackCar.x} ${fallbackCar.y})`}>
				<circle r="38" stroke="#ceff56" stroke-opacity=".3" stroke-dasharray="3 5"></circle>
				<rect x="-5" y="-9" width="10" height="18" rx="2" fill="#ceff56"></rect>
				<rect x="-3" y="-3" width="6" height="6" fill="#1a2115"></rect>
			</g>
		</svg>
	</div>
	<div class="static-guide">
		<div class="static-heading">
			<h2>高速循迹赛道</h2>
			<p>程序化场景俯视图，虚线表示参考路径。</p>
		</div>
		<div class="static-footer">
			<ul class="static-legend" aria-label="赛道图例">
				<li><i class="cone-left" aria-hidden="true"></i>左侧边界</li>
				<li><i class="cone-right" aria-hidden="true"></i>右侧边界</li>
				<li><i class="cone-stop" aria-hidden="true"></i>停车区域</li>
			</ul>
			<a class="static-link" href={withBase('/projects/ros2-lts-final/')}>查看 ROS 2 无人车项目</a>
		</div>
	</div>
	<canvas class="scene-canvas" aria-hidden="true"></canvas>
	<div
		class="scene-interaction"
