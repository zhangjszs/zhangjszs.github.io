	<div class="scene-detection-labels" data-fsac-labels aria-hidden="true"></div>

	<div class="scene-topline">
		<span class="scene-id"><i></i> KZ / SPATIAL ENGINE</span>
		<span class="scene-origin scene-origin-fsac">FSAC 2025 规则 · 程序化算法示意 <span>/ 非实测</span></span>
		<span class="scene-origin scene-origin-orbit">ORBITAL SANDBOX <span>/ 程序化轨道示意</span></span>
	</div>

	<div class="fsac-toolbar" data-fsac-toolbar>
		<label class="scene-course">
			<span>赛道</span>
			<select data-fsac-course aria-label="选择 FSAC 演示赛道" disabled>
				<option value="autocross">高速循迹 / AUTOCROSS</option>
				<option value="skidpad">八字环绕 / SKIDPAD</option>
				<option value="acceleration">直线加速 / ACCELERATION</option>
			</select>
		</label>
		<div class="scene-counts" aria-label="程序化演示计算结果" data-fsac-counts>
			<span>视域锥桶 <strong data-fsac-visible>—</strong></span>
			<span>累计地图 <strong data-fsac-known>—</strong></span>
			<span class="scene-total-count">赛道总数 <strong data-fsac-total>—</strong></span>
			<span class="scene-plan-count">局部轨迹 <strong data-fsac-lookahead>—</strong></span>
		</div>
